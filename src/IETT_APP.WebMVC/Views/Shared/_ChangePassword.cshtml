@using IETT_APP.WebMVC.Models
@model ChangePasswordViewModel

<form id="changePasswordForm">
    <div class="row mb-3">
        <label asp-for="CurrentPassword" class="col-sm-3 col-form-label fw-bold">Mevcut Şifre</label>
        <div class="col-sm-9">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                <input asp-for="CurrentPassword" class="form-control" placeholder="Mevcut şifrenizi giriniz" />
            </div>
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="NewPassword" class="col-sm-3 col-form-label fw-bold">Yeni Şifre</label>
        <div class="col-sm-9">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-key"></i></span>
                <input asp-for="NewPassword" class="form-control" placeholder="En az 6 karakter" />
            </div>
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="ConfirmPassword" class="col-sm-3 col-form-label fw-bold">Yeni Şifre (Tekrar)</label>
        <div class="col-sm-9">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-check-lg"></i></span>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Yeni şifreyi tekrar giriniz" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
    </div>

    <div class="form-group row mt-4">
        <div class="offset-sm-3 col-sm-9">
            <button type="button" id="btnChangePassword" class="btn btn-danger">
                <i class="bi bi-save"></i> Şifreyi Güncelle
            </button>
        </div>
    </div>
</form>