@using IETT_APP.WebMVC.Models
@model ChangePasswordViewModel

<div class="alert alert-light border-start border-4 border-warning shadow-sm mb-4" role="alert">
    <div class="d-flex">
        <div class="me-3">
            <i class="bi bi-shield-lock-fill fs-3 text-warning"></i>
        </div>
        <div>
            <h6 class="fw-bold mb-1">Güvenlik Önerileri</h6>
            <div class="small text-muted">
                Şifreniz en az 6 karakter olmalı, harf ve rakam içermelidir.
                Güvenliğiniz için şifrenizi kimseyle paylaşmayınız.
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-none">
    <div class="card-body p-0">
        <form id="changePasswordForm">

            <div class="mb-4">
                <label asp-for="CurrentPassword" class="form-label fw-bold text-secondary small text-uppercase">
                    Mevcut Şifre
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-primary">
                        <i class="bi bi-unlock-fill"></i>
                    </span>

                    <input asp-for="CurrentPassword" type="password" class="form-control bg-light border-start-0 border-end-0" id="txtCurrentPassword" placeholder="••••••••" />

                    <button class="btn btn-light border border-start-0 text-muted" type="button" id="btnToggleCurrentPassword">
                        <i class="bi bi-eye" id="iconCurrentPassword"></i>
                    </button>
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="NewPassword" class="form-label fw-bold text-secondary small text-uppercase">
                        Yeni Şifre
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-success">
                            <i class="bi bi-key-fill"></i>
                        </span>
                        <input asp-for="NewPassword" type="password" class="form-control bg-light border-start-0" placeholder="En az 6 karakter" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold text-secondary small text-uppercase">
                        Yeni Şifre (Tekrar)
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-success">
                            <i class="bi bi-check-circle-fill"></i>
                        </span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control bg-light border-start-0" placeholder="Şifreyi doğrulayın" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <hr class="text-muted opacity-25 my-4">

            <div class="d-flex justify-content-end align-items-center">
                <div class="text-muted small me-3 fst-italic">
                    <i class="bi bi-info-circle me-1"></i> Değişiklik sonrası oturumunuz kapanabilir.
                </div>
                <button type="button" id="btnChangePassword" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                    <i class="bi bi-save2-fill me-2"></i> Şifreyi Güncelle
                </button>
            </div>

        </form>
    </div>
</div>

<script>
    document.getElementById('btnToggleCurrentPassword').addEventListener('click', function () {
        var passwordInput = document.getElementById('txtCurrentPassword');
        var icon = document.getElementById('iconCurrentPassword');

        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash'); // Çizgili göz
        } else {
            passwordInput.type = 'password';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye'); // Normal göz
        }
    });
</script>