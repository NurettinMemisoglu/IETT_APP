@using System.Security.Claims
@{
    // Sayfaya özel CSS/JS yüklemek için Controller adını alıyoruz
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!doctype html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>IETT APP</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#007bff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="~/css/adminlte.css" />
    <link rel="stylesheet" href="~/css/maps.css" />

    @if (string.Equals(currentController, "Routes", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/routes.css" />
    }
    @if (string.Equals(currentController, "Vehicles", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/vehicles.css" />
    }
    @if (string.Equals(currentController, "TripTasks", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/triptasks.css" />
    }
    <link rel="stylesheet" href="~/css/district.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jsvectormap@1.5.3/dist/css/jsvectormap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/material_blue.css">

    @RenderSection("Styles", required: false)
</head>
<body class="layout-fixed sidebar-expand-lg sidebar-open bg-body-tertiary d-flex flex-column min-vh-100">
    <div class="app-wrapper">

        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                            <i class="bi bi-list"></i>
                        </a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link">Anasayfa</a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="#" data-lte-toggle="fullscreen">
                            <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                            <i data-lte-icon="minimize" class="bi bi-fullscreen-exit" style="display: none"></i>
                        </a>
                    </li>


                    <li class="nav-item dropdown">
                        @await Component.InvokeAsync("NotificationBell")
                    </li>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        // Cookie'den okunan değerler
                        var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;
                        var profilePath = User.FindFirst("ProfileImage")?.Value;

                        // Resim yolu (Claim'de yoksa varsayılanı kullan)
                        var userImage = string.IsNullOrEmpty(profilePath)
                        ? "/assets/img/user2-160x160.jpg"
                        : $"https://localhost:7254{profilePath}";

                        var rolesList = User.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();
                        var userRolesDisplay = rolesList.Any() ? string.Join(", ", rolesList) : "Personel";

                        <li class="nav-item dropdown user-menu">
                            <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                <img src="@userImage" id="navbarThumbnail" class="user-image rounded-circle shadow" alt="User Image" style="object-fit: cover;" />
                                <span class="d-none d-md-inline">@fullName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                                <li class="user-header text-bg-primary">
                                    <img src="@userImage" id="navbarHeaderImage" class="rounded-circle shadow" alt="User Image" style="object-fit: cover;" />
                                    <p>
                                        @fullName
                                        <small>@userRolesDisplay</small>
                                    </p>
                                </li>

                                <li class="user-footer">
                                    @if (rolesList.Contains("Admin"))
                                    {
                                        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-default btn-flat float-start me-1">Admin Paneli</a>
                                    }
                                    @if (rolesList.Contains("Driver"))
                                    {
                                        <a asp-area="Driver" asp-controller="Profile" asp-action="Index" class="btn btn-default btn-flat float-start me-1">Profilim</a>
                                    }
                                    @if (!rolesList.Any(r => r == "Admin" || r == "Chief" || r == "Planner" || r == "Driver"))
                                    {
                                        <a href="#" class="btn btn-default btn-flat float-start">Ayarlar</a>
                                    }

                                    <a asp-area="" asp-controller="Auth" asp-action="Logout" class="btn btn-default btn-flat float-end">Çıkış Yap</a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Auth" asp-action="Login">Giriş Yap</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
        <aside class="app-sidebar bg-body-secondary shadow" style="width: 250px; overflow: hidden; padding-bottom: 70px;" data-bs-theme="dark">
            <div class="sidebar-wrapper position-relative" style="height: 100vh; overflow: hidden;">

                <div class="sidebar-brand">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="brand-link">
                        <img src="~/assets/img/AdminLTELogo.png" alt="Logo" class="brand-image opacity-75 shadow" />
                        <span class="brand-text fw-light">IETT APP</span>
                    </a>
                </div>

                <div class="sidebar-menu" style="padding-bottom: 70px;">
                    @if (IsSectionDefined("Sidebar"))
                    {
                        @RenderSection("Sidebar")
                    }
                    else
                    {
                        // 1. Admin Rolü Varsa Menüsünü Göster
                        @if (User.IsInRole("Admin"))
                        {
                            @await Html.PartialAsync("~/Areas/Admin/Views/_Sidebar_Admin.cshtml")
                        }

                        // 2. Planner Rolü Varsa Menüsünü Göster (Else kullanmıyoruz!)
                        @if (User.IsInRole("Planner"))
                        {
                            @await Html.PartialAsync("~/Areas/Planner/Views/_Sidebar_Planner.cshtml")
                        }

                        // 3. Chief Rolü Varsa Menüsünü Göster
                        @if (User.IsInRole("Chief"))
                        {
                            @await Html.PartialAsync("~/Areas/Chief/Views/_Sidebar_Chief.cshtml")
                        }

                        // 4. Driver Rolü Varsa Menüsünü Göster
                        @if (User.IsInRole("Driver"))
                        {
                            @await Html.PartialAsync("~/Areas/Driver/Views/_Sidebar_Driver.cshtml")
                        }

                        // 5. Eğer HİÇBİR özel rolü yoksa Standart User menüsünü göster
                        @if (!User.IsInRole("User"))
                        {
                            @await Html.PartialAsync("_Sidebar_User")
                        }
                    }
                </div>
            </div>
        </aside>
        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                </div>
            </div>

            <div class="app-content">
                <div class="container-fluid p-4">
                    <div class="row">
                        <div class="col-12">
                            @RenderBody()
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <footer class="app-footer">
            <div class="float-end d-none d-sm-inline">v1.0</div>
            <strong>Copyright &copy; @DateTime.Now.Year IETT Operasyon.</strong> Tüm hakları saklıdır.
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/browser/overlayscrollbars.browser.es6.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/tr.js"></script>

    <script>
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
          return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>

    <script>
        var currentUserToken = "@(User.FindFirst("AccessToken")?.Value ?? "")";
    </script>

    <script src="~/js/adminlte.js"></script>
    <script src="~/js/site.js" asp-append-version="true" ></script>

    @if (string.Equals(currentController, "Stops", StringComparison.OrdinalIgnoreCase))
    {
        <script src="~/js/stops-map.js?v=@DateTime.Now.Ticks"></script>
        <script async src="~/js/stops.js?v=@DateTime.Now.Ticks"></script>
    }
    @if (string.Equals(currentController, "Routes", StringComparison.OrdinalIgnoreCase))
    {
        <script src="~/js/routes.js?v=@DateTime.Now.Ticks"></script>
        <script src="~/js/routes-map.js?v=@DateTime.Now.Ticks"></script>
    }
    @if (string.Equals(currentController, "Lines", StringComparison.OrdinalIgnoreCase))
    {
        <script src="~/js/lines.js?v=@DateTime.Now.Ticks"></script>
    }
    @if (string.Equals(currentController, "Vehicles", StringComparison.OrdinalIgnoreCase))
    {
        <script src="~/js/vehicles.js?v=@DateTime.Now.Ticks"></script>
    }
    @if (string.Equals(currentController, "TripTasks", StringComparison.OrdinalIgnoreCase))
    {
        <script src="~/js/chief-triptask.js" asp-append-version="true"></script>
    }
    @if (string.Equals(currentController, "Profile", StringComparison.OrdinalIgnoreCase))
    {
        <script src="~/js/driver-profile.js" asp-append-version="true"></script>
    }

    <script async defer src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBrsuVWjUgd1nNrH-4lU4lblxegEEkrQGw&libraries=places&callback=initMap"></script>

    <script>
        const SELECTOR_SIDEBAR_WRAPPER = '.sidebar-wrapper';
        const Default = {
            scrollbarTheme: 'os-theme-light',
            scrollbarAutoHide: 'leave',
            scrollbarClickScroll: true,
        };
        document.addEventListener('DOMContentLoaded', function () {
            const sidebarWrapper = document.querySelector(SELECTOR_SIDEBAR_WRAPPER);
            if (sidebarWrapper && OverlayScrollbarsGlobal?.OverlayScrollbars !== undefined) {
                OverlayScrollbarsGlobal.OverlayScrollbars(sidebarWrapper, {
                    scrollbars: {
                        theme: Default.scrollbarTheme,
                        autoHide: Default.scrollbarAutoHide,
                        clickScroll: Default.scrollbarClickScroll,
                    },
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>