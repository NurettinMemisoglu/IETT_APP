@using System.Security.Claims
@inject IConfiguration Configuration
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var apiBaseUrl = "https://localhost:7254"; // API Portun

    // --- PROFİL RESMİ MANTIĞI (MERKEZİ) ---
    string finalUserImage = "/assets/img/user2-160x160.jpg"; // Varsayılan

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var profilePath = User.FindFirst("ProfileImage")?.Value;
        if (!string.IsNullOrEmpty(profilePath))
        {
            if (profilePath.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            {
                if (profilePath.Contains(":7060"))
                {
                    finalUserImage = profilePath.Replace(":7060", ":7254");
                }
                else
                {
                    finalUserImage = profilePath;
                }
            }
            else
            {
                if (!profilePath.StartsWith("/")) profilePath = "/" + profilePath;
                finalUserImage = $"{apiBaseUrl}{profilePath}";
            }
        }
    }

    ViewData["FinalUserImage"] = finalUserImage;
    var currentUserFullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Kullanıcı";

    var sidebarCookie = Context.Request.Cookies["IETT_SidebarState"];
    var sidebarClass = (sidebarCookie == "closed") ? "sidebar-collapse" : "";
}
<!doctype html>
<html lang="tr">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>IETT Operasyon</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0d6efd" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/adminlte.css" />

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/styles/overlayscrollbars.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jsvectormap@1.5.3/dist/css/jsvectormap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/maps.css" />

    @if (string.Equals(currentController, "Routes", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/routes.css" asp-append-version="true" />
    }
    @if (string.Equals(currentController, "Vehicles", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/vehicles.css" asp-append-version="true" />
    }
    @if (string.Equals(currentController, "TripTasks", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/triptasks.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/district.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body class="layout-fixed layout-navbar-fixed sidebar-expand-lg bg-body-tertiary @sidebarClass">
    <div class="app-wrapper">

        <nav class="app-header navbar navbar-expand bg-body sticky-top shadow-sm">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center justify-content-center" data-lte-toggle="sidebar" href="#" role="button">
                            <i class="bi bi-list fs-3" style="line-height: 1;"></i>
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item d-none d-sm-block me-2">
                        <a class="nav-link" href="#" data-lte-toggle="fullscreen">
                            <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                            <i data-lte-icon="minimize" class="bi bi-fullscreen-exit" style="display: none"></i>
                        </a>
                    </li>

                    <li class="nav-item dropdown me-2">
                        @await Component.InvokeAsync("NotificationBell")
                    </li>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var rolesList = User.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();
                        var userRolesDisplay = rolesList.Any() ? string.Join(", ", rolesList) : "Personel";

                        <li class="nav-item dropdown user-menu">
                            <a href="#" class="nav-link dropdown-toggle d-flex align-items-center gap-2" data-bs-toggle="dropdown">
                                <img src="@finalUserImage" class="user-image rounded-circle shadow-sm border" alt="User" style="width:35px; height:35px; object-fit: cover;">
                                <span class="d-none d-md-inline fw-semibold text-dark">@currentUserFullName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" style="border-radius:12px; overflow:hidden;">
                                <li class="user-header bg-primary text-white text-center py-4">
                                    <img src="@finalUserImage" class="rounded-circle shadow border border-2 border-white mb-2" style="width:70px;height:70px; object-fit:cover;" alt="User">
                                    <p class="mb-0 fw-bold">@currentUserFullName</p>
                                    <small class="opacity-75">@userRolesDisplay</small>
                                </li>
                                <li class="user-body p-2">
                                    @if (rolesList.Contains("Driver"))
                                    {
                                        <a asp-area="Driver" asp-controller="Profile" asp-action="Index" class="dropdown-item rounded py-2">
                                            <i class="bi bi-person me-2 text-primary"></i> Profilim
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="#" class="dropdown-item rounded py-2">
                                            <i class="bi bi-gear me-2 text-secondary"></i> Ayarlar
                                        </a>
                                    }
                                </li>
                                <li class="user-footer bg-light p-2 text-center">
                                    <a asp-area="" asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger btn-sm w-100">
                                        Güvenli Çıkış
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-primary rounded-pill px-4 btn-sm" asp-controller="Auth" asp-action="Login">Giriş</a>
                        </li>
                    }
                </ul>
            </div>
        </nav>

        <aside class="app-sidebar shadow" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="brand-link text-decoration-none">
                    <img src="~/assets/img/AdminLTELogo.png" alt="Logo" class="brand-image opacity-75 shadow-sm bg-white rounded-circle p-1" />
                    <span class="brand-text fw-light">IETT APP</span>
                </a>
            </div>

            <div class="sidebar-wrapper">
                @if (IsSectionDefined("Sidebar"))
                {
                    @RenderSection("Sidebar")
                }
                else
                {
                    @if (User.IsInRole("Admin"))
                    {
                        @await Html.PartialAsync("~/Areas/Admin/Views/_Sidebar_Admin.cshtml")
                    }
                    @if (User.IsInRole("Planner"))
                    {

                        @await Html.PartialAsync("~/Areas/Planner/Views/_Sidebar_Planner.cshtml")
                    }
                    @if (User.IsInRole("Chief"))
                    {

                        @await Html.PartialAsync("~/Areas/Chief/Views/_Sidebar_Chief.cshtml")
                    }
                    @if (User.IsInRole("Driver"))
                    {

                        @await Html.PartialAsync("~/Areas/Driver/Views/_Sidebar_Driver.cshtml")
                    }
                    @if (!User.IsInRole("User"))
                    {

                        @await Html.PartialAsync("_Sidebar_User")
                    }
                }
            </div>
        </aside>

        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid"></div>
            </div>
            <div class="app-content">
                <div class="container-fluid p-4">
                    @RenderBody()
                </div>
            </div>
        </main>

        <footer class="app-footer bg-white">
            <div class="float-end d-none d-sm-inline small text-muted">v1.0.0</div>
            <strong class="small text-muted">Copyright &copy; @DateTime.Now.Year IETT Operasyon.</strong>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/browser/overlayscrollbars.browser.es6.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.37.1/dist/apexcharts.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/tr.js"></script>

    <script src="~/js/adminlte.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) { return new bootstrap.Tooltip(tooltipTriggerEl) })
        var currentUserToken = "@(User.FindFirst("AccessToken")?.Value ?? "")";

        // Flex Sidebar yapısı için doğru selektör (site.css'e göre güncellendi)
        // Eğer site.css'de sidebar-content-scroll kullanıyorsak burayı ona göre ayarlayabiliriz
        const SELECTOR_SIDEBAR = '.sidebar-content-scroll';
        // Fallback olarak wrapper'ı da kontrol ediyoruz
        const SELECTOR_WRAPPER = '.sidebar-wrapper';

        const Default = { scrollbarTheme: 'os-theme-light', scrollbarAutoHide: 'leave', scrollbarClickScroll: true };

        document.addEventListener('DOMContentLoaded', function () {
            // Önce scroll edilecek özel alanı arıyoruz, yoksa genel wrapper'a uyguluyoruz
            let targetEl = document.querySelector(SELECTOR_SIDEBAR) || document.querySelector(SELECTOR_WRAPPER);

            if (targetEl && OverlayScrollbarsGlobal?.OverlayScrollbars !== undefined) {
                OverlayScrollbarsGlobal.OverlayScrollbars(targetEl, {
                    scrollbars: { theme: Default.scrollbarTheme, autoHide: Default.scrollbarAutoHide, clickScroll: Default.scrollbarClickScroll },
                });
            }
        });

        function initMap() { console.log("Map Loaded"); }
    </script>
    <script async defer src="https://maps.googleapis.com/maps/api/js?key=@Configuration["GoogleMaps:ApiKey"]&libraries=places&callback=initMap"></script>

    @if (string.Equals(currentController, "Stops", StringComparison.OrdinalIgnoreCase))
    {
        <script src="~/js/stops-map.js" asp-append-version="true"></script>
        <script src="~/js/stops.js" asp-append-version="true" async></script>
    }
    @if (string.Equals(currentController, "Routes", StringComparison.OrdinalIgnoreCase))
    {
        <script src="~/js/routes.js" asp-append-version="true"></script>
        <script src="~/js/routes-map.js" asp-append-version="true"></script>
    }
    @if (string.Equals(currentController, "Lines", StringComparison.OrdinalIgnoreCase))
    {
        <script src="~/js/lines.js" asp-append-version="true"></script>
    }
    @if (string.Equals(currentController, "Vehicles", StringComparison.OrdinalIgnoreCase))
    {
        <script src="~/js/vehicles.js" asp-append-version="true"></script>
    }
    @if (string.Equals(currentController, "TripTasks", StringComparison.OrdinalIgnoreCase))
    {
        <script src="~/js/chief-triptask.js" asp-append-version="true"></script>
    }
    @if (string.Equals(currentController, "Profile", StringComparison.OrdinalIgnoreCase))
    {
        <script src="~/js/driver-profile.js" asp-append-version="true"></script>
    }

    <partial name="_NotificationPartial" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>