@using IETT_APP.WebMVC.Models
@model RegisterViewModel

@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] | İETT Operasyon</title>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/auth.css" />
</head>

<body class="login-page">

    <div class="login-box" style="width: 450px;">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <a href="/" class="h1"><b>İETT</b> Operasyon</a>
            </div>
            <div class="card-body">
                <p class="login-box-msg">Yeni üyelik oluşturun</p>

                <form asp-controller="Auth" asp-action="Register" method="post">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

                    <div class="input-group mb-3">
                        <input asp-for="Name" class="form-control" placeholder="Ad">
                        <div class="input-group-text">
                            <span class="bi bi-person"></span>
                        </div>
                    </div>
                    <span asp-validation-for="Name" class="text-danger small d-block mb-2"></span>

                    <div class="input-group mb-3">
                        <input asp-for="Surname" class="form-control" placeholder="Soyad">
                        <div class="input-group-text">
                            <span class="bi bi-person"></span>
                        </div>
                    </div>
                    <span asp-validation-for="Surname" class="text-danger small d-block mb-2"></span>

                    <div class="input-group mb-3">
                        <input asp-for="Email" type="email" class="form-control" placeholder="E-Posta Adresi">
                        <div class="input-group-text">
                            <span class="bi bi-envelope"></span>
                        </div>
                    </div>
                    <span asp-validation-for="Email" class="text-danger small d-block mb-2"></span>

                    <div class="input-group mb-3">
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Telefon (5xxxxxxxxx)">
                        <div class="input-group-text">
                            <span class="bi bi-phone"></span>
                        </div>
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-danger small d-block mb-2"></span>

                    <div class="input-group mb-3">
                        <input asp-for="Password" type="password" class="form-control" placeholder="Şifre">
                        <div class="input-group-text">
                            <span class="bi bi-lock-fill"></span>
                        </div>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small d-block mb-2"></span>

                    <div class="input-group mb-3">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Şifre Tekrar">
                        <div class="input-group-text">
                            <span class="bi bi-lock-fill"></span>
                        </div>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mb-2"></span>

                    <div class="row mt-4">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary w-100">Kayıt Ol</button>
                        </div>
                    </div>
                </form>

                <p class="mb-0 mt-3 text-center">
                    <a asp-controller="Auth" asp-action="Login" class="text-center">Zaten üyeliğim var</a>
                </p>
            </div>
        </div>

        <div class="text-center mt-3 text-muted small">
            &copy; @DateTime.Now.Year İETT İşletmeleri Genel Müdürlüğü
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function() {
            // Toast Ayarları (Sağ üst köşe, 3 saniye görünür)
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            // Backend'den Başarılı Mesaj Geldi mi? (TempData)
            var successMsg = '@TempData["SuccessMessage"]';
            if (successMsg) {
                Toast.fire({
                    icon: 'success',
                    title: successMsg
                });
            }

            // Backend'den Hata Mesajı Geldi mi? (TempData)
            var errorMsg = '@TempData["ErrorMessage"]';
            if (errorMsg) {
                Toast.fire({
                    icon: 'error',
                    title: errorMsg
                });
            }
        });
    </script>
</body>
</html>