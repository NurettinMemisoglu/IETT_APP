@{
    ViewData["Title"] = "Erişim Reddedildi";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] | İETT Operasyon</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body class="login-page">
    <div class="error-page" style="width: 600px; margin: 100px auto;">
        <h2 class="headline text-danger">403</h2>

        <div class="error-content">
            <h3><i class="bi bi-exclamation-triangle text-danger"></i> Erişim Engellendi!</h3>

            <p>
                Bu sayfayı görüntülemek için gerekli yetkiye sahip değilsiniz.
                Sistem yöneticinizle görüşebilir veya anasayfaya dönebilirsiniz.
            </p>

            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-danger btn-flat">
                    <i class="bi bi-house-door"></i> Anasayfaya Dön
                </a>
                <a href="javascript:history.back()" class="btn btn-default btn-flat">
                    <i class="bi bi-arrow-left"></i> Geri Dön
                </a>
            </div>
        </div>
    </div>
</body>
</html>