@{
    ViewData["Title"] = "Çıkış Yap";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] | İETT Operasyon</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/css/auth.css" />
</head>

<body class="login-page">
    <div class="login-box">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <a href="/" class="h1"><b>İETT</b> Operasyon</a>
            </div>
            <div class="card-body">
                <div class="text-center">
                    <h4 class="mb-3">Oturumu Kapat</h4>
                    <p class="login-box-msg">
                        Merhaba <strong>@User.Identity?.Name</strong>,<br>
                        çıkış yapmak istediğinize emin misiniz?
                    </p>

                    <form asp-action="Logout" method="post">
                        <div class="row">
                            <div class="col-6">
                                <a asp-controller="Home" asp-action="Index" class="btn btn-default btn-block">İptal</a>
                            </div>
                            <div class="col-6">
                                <button type="submit" class="btn btn-danger btn-block">Çıkış Yap</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>