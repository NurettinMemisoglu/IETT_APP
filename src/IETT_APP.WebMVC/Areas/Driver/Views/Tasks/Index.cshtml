@using IETT_APP.WebMVC.Areas.Driver.Models
@using IETT_APP.Domain.Enums
@using IETT_APP.WebMVC.Extensions
@model IEnumerable<DriverTripTaskViewModel>

@{
    ViewData["Title"] = "Görev Listesi";

    // Request Nesnesi
    var request = ViewContext.HttpContext.Request;

    // Parametreleri Al
    string searchTerm = request.Query["search"].ToString();
    string statusFilter = request.Query["status"].ToString();
    string dateFilterStr = request.Query["date"].ToString();

    // 🛠️ DÜZELTME: Değişken adını 'page' yerine 'currentPage' yaptık.
    int currentPage = int.TryParse(request.Query["page"], out int p) ? p : 1;
    int pageSize = 15;

    // --- VERİYİ FİLTRELEME ---
    var query = Model.AsQueryable();

    // 1. Arama
    if (!string.IsNullOrEmpty(searchTerm))
    {
        searchTerm = searchTerm.ToLower();
        query = query.Where(x =>
            (x.LineName != null && x.LineName.ToLower().Contains(searchTerm)) ||
            (x.RouteName != null && x.RouteName.ToLower().Contains(searchTerm)) ||
            (x.VehicleName != null && x.VehicleName.ToLower().Contains(searchTerm)) ||
            (x.Title != null && x.Title.ToLower().Contains(searchTerm))
        );
    }

    // 2. Durum
    if (!string.IsNullOrEmpty(statusFilter) && statusFilter != "All")
    {
        if (Enum.TryParse<TaskState>(statusFilter, out var statusEnum))
        {
            query = query.Where(x => x.Status == statusEnum);
        }
    }

    // 3. Tarih
    if (DateTime.TryParse(dateFilterStr, out var filterDate))
    {
        query = query.Where(x =>
            (x.AdjustedDeparture ?? x.ScheduledDeparture).HasValue &&
            (x.AdjustedDeparture ?? x.ScheduledDeparture).Value.Date == filterDate.Date
        );
    }

    // 4. Sıralama
    var filteredList = query.OrderByDescending(t => t.AdjustedDeparture ?? t.ScheduledDeparture).ToList();

    // 5. Sayfalama Hesaplaması
    int totalItems = filteredList.Count;
    int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);

    if (totalPages > 0)
    {
        currentPage = Math.Max(1, Math.Min(currentPage, totalPages));
    }

    var pagedTasks = filteredList.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
}

<style>
    /* TASARIM STİLLERİ */
    .filter-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        border: 1px solid #f0f0f0;
    }

    .task-list-card {
        border: none;
        border-radius: 16px;
        transition: transform 0.2s, box-shadow 0.2s;
        background: #fff;
        overflow: hidden;
        border: 1px solid #e9ecef;
    }

        .task-list-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            border-color: #dee2e6;
        }

    /* Sol Kenar Çizgileri */
    .border-left-pending {
        border-left: 5px solid #ffc107;
    }

    .border-left-accepted {
        border-left: 5px solid #0dcaf0;
    }

    .border-left-inprogress {
        border-left: 5px solid #0d6efd;
    }

    .border-left-completed {
        border-left: 5px solid #198754;
    }

    .border-left-cancelled {
        border-left: 5px solid #dc3545;
    }

    .border-left-incomplete {
        border-left: 5px solid #6c757d; /* Gri */
    }

    .date-badge {
        background: #eef2f7;
        color: #495057;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 5px 12px;
        border-radius: 20px;
    }

    /* Pagination */
    .page-link {
        border-radius: 50% !important;
        margin: 0 3px;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        color: #555;
    }

    .page-item.active .page-link {
        background-color: #0d6efd;
        color: white;
        box-shadow: 0 4px 10px rgba(13, 110, 253, 0.3);
    }

    .page-item.disabled .page-link {
        background-color: transparent;
        color: #ccc;
    }

    .totalItems-btn {
        background-color: #dc3545 !important;
        color: white !important;
        border-color: #dc3545 !important;
    }
</style>

<div class="container-fluid mt-4 mb-5" style="max-width: 1200px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="bi bi-list-check text-primary me-2"></i>Görevlerim</h3>
            <p class="text-muted small m-0">Size atanan seferleri filtreleyebilir ve yönetebilirsiniz.</p>
        </div>
        <div class="d-none d-md-block">
            <span class="totalItems-btn bg-#dc3545 text-decoration-none rounded-pill px-3 py-2 fs-6 shadow-sm position-relative">Toplam: @totalItems Görev</span>
        </div>
    </div>

    <div class="filter-card p-4 mb-4">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted text-uppercase">Arama</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="Hat, Güzergah veya Plaka..." value="@searchTerm">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted text-uppercase">Tarih</label>
                <input type="date" name="date" class="form-control bg-light" value="@dateFilterStr">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted text-uppercase">Durum</label>
                <select name="status" class="form-select bg-light">
                    <option value="All">Tümü</option>
                    <!option value="Pending" @(statusFilter == "Pending" ? "selected" : "")>Bekleyen</!option>
                    <!option value="Accepted" @(statusFilter == "Accepted" ? "selected" : "")>Kabul Edilen</!option>
                    <!option value="InProgress" @(statusFilter == "InProgress" ? "selected" : "")>Seferde</!option>
                    <!option value="Completed" @(statusFilter == "Completed" ? "selected" : "")>Tamamlanan</!option>
        
                    <!option value="Cancelled" @(statusFilter == "Cancelled" ? "selected" : "")>İptal Edilen</!option>
                    <!option value="Incomplete" @(statusFilter == "Incomplete" ? "selected" : "")>Yarım Kalan</!option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100 fw-bold"><i class="bi bi-funnel-fill"></i> Filtrele</button>
            </div>
            @if (!string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(statusFilter) || !string.IsNullOrEmpty(dateFilterStr))
            {
                <div class="col-12 mt-2">
                    <a href="@Url.Action("Index")" class="text-danger small text-decoration-none"><i class="bi bi-x-circle"></i> Filtreleri Temizle</a>
                </div>
            }
        </form>
    </div>

    @if (!pagedTasks.Any())
    {
        <div class="text-center py-5 filter-card">
            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-inbox fs-1 text-secondary"></i>
            </div>
            <h5 class="fw-bold text-muted">Kayıt Bulunamadı</h5>
            <p class="text-muted small">Arama kriterlerinize uygun görev yok.</p>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm rounded-pill px-4">Tümünü Göster</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var task in pagedTasks)
            {
                var time = task.AdjustedDeparture ?? task.ScheduledDeparture;
                string formattedDate = time.HasValue ? time.Value.ToString("dd.MM.yy HH:mm") : "-";

                string borderClass = task.Status switch
                {
                    TaskState.Pending => "border-left-pending",
                    TaskState.Accepted => "border-left-accepted",
                    TaskState.InProgress => "border-left-inprogress",
                    TaskState.Completed => "border-left-completed",
                    TaskState.Cancelled => "border-left-cancelled",
                    TaskState.Incomplete => "border-left-incomplete", // Yeni
                    _ => ""
                };

                string badgeClass = task.Status switch
                {
                    TaskState.Pending => "bg-warning text-dark bg-opacity-25 border border-warning",
                    TaskState.Accepted => "bg-info text-dark bg-opacity-25 border border-info",
                    TaskState.InProgress => "bg-primary text-white",
                    TaskState.Completed => "bg-success text-white",

                    // YENİ EKLENENLER
                    TaskState.Cancelled => "bg-danger text-white",
                    TaskState.Incomplete => "bg-secondary text-white",

                    _ => "bg-light text-dark"
                };

                <div class="col-lg-4 col-md-6">
                    <div class="task-list-card h-100 p-3 d-flex flex-column @borderClass">

                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge @badgeClass rounded-pill px-3">@task.Status.ToDisplayName()</span>
                            <div class="date-badge shadow-sm">
                                <i class="bi bi-calendar-event me-1 text-muted"></i> @formattedDate
                            </div>
                        </div>

                        <div class="mb-3 flex-grow-1">
                            <div class="d-flex align-items-center mb-2">
                                <div class="fs-4 fw-bold me-2 text-dark">@task.LineName</div>
                                <div class="vr mx-2"></div>
                                <div class="text-truncate fw-bold text-secondary">@task.Title</div>
                            </div>
                            <div class="d-flex align-items-center text-muted small mb-2">
                                <i class="bi bi-geo-alt-fill me-2 text-primary"></i>
                                <span class="text-truncate">@task.RouteName</span>
                            </div>
                            <div class="d-flex align-items-center text-muted small">
                                <i class="bi bi-bus-front-fill me-2 text-secondary"></i>
                                <span>@task.VehicleName</span>
                            </div>
                        </div>

                        <div class="mt-auto border-top pt-3 d-flex justify-content-between align-items-center">
                            @if (task.AdjustedDeparture.HasValue)
                            {
                                <small class="text-danger fw-bold"><i class="bi bi-exclamation-circle"></i> Revize Saat</small>
                            }
                            else
                            {

                                <small class="text-muted">Planlanan</small>
                            }

                            <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold shadow-sm">
                                Detay <i class="bi bi-arrow-right-short"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, search = searchTerm, status = statusFilter, date = dateFilterStr })"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, search = searchTerm, status = statusFilter, date = dateFilterStr })">@i</a>
                            </li>
                        }
                        else if (i == currentPage - 3 || i == currentPage + 3)
                        {
                            <li class="page-item disabled"><span class="page-link border-0">...</span></li>
                        }
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, search = searchTerm, status = statusFilter, date = dateFilterStr })"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
                <div class="text-center text-muted small mt-2">Sayfa @currentPage / @totalPages</div>
            </nav>
        }
    }
</div>