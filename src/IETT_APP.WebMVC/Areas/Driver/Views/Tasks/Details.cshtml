@using IETT_APP.WebMVC.Areas.Driver.Models
@using IETT_APP.Domain.Enums
@using IETT_APP.WebMVC.Extensions
@model DriverTripTaskViewModel

@{
    ViewData["Title"] = "Görev Detayı";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold m-0"><i class="bi bi-info-circle text-primary me-2"></i>Görev Detayı</h4>
        <a asp-action="Index" class="btn btn-secondary shadow-sm">
            <i class="bi bi-arrow-left"></i> Geri
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">Görev No: @Model.Id.ToString().Substring(0, 8)</span>
                <span class="badge @GetStatusBadgeClass(Model.Status) px-3 py-2 fs-6">
                    @Model.Status.ToDisplayName()
                </span>
            </div>
        </div>

        <div class="card-body">
            <h5 class="card-title fw-bold text-primary mb-3">@Model.Title</h5>

            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <small class="text-muted d-block">Hat Kodu</small>
                    <span class="fw-bold fs-5">@Model.LineName</span>
                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted d-block">Güzergah</small>
                    <span class="fw-bold">@Model.RouteName</span>
                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted d-block">Araç</small>
                    <span class="fw-bold"><i class="bi bi-bus-front"></i> @Model.VehicleName</span>
                </div>
                <div class="col-6 col-md-3">
                    <small class="text-muted d-block">Başlangıç Garajı</small>
                    <span class="fw-bold">@Model.GarageName</span>
                </div>
            </div>

            <hr class="text-muted opacity-25">

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <div class="p-3 bg-light rounded border">
                        <h6 class="text-secondary fw-bold mb-3"><i class="bi bi-calendar-event me-2"></i>Planlanan</h6>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Kalkış:</span>
                            <span class="fw-bold">@Model.ScheduledDeparture?.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Varış:</span>
                            <span class="fw-bold">@Model.ScheduledArrival?.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="p-3 border rounded @(Model.ActualDeparture.HasValue ? "bg-success-subtle border-success" : "bg-light")">
                        <h6 class="text-secondary fw-bold mb-3"><i class="bi bi-stopwatch me-2"></i>Gerçekleşen</h6>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Kalkış:</span>
                            <span class="@(Model.ActualDeparture.HasValue ? "fw-bold text-success" : "text-muted fst-italic")">
                                @(Model.ActualDeparture?.ToString("HH:mm") ?? "--:--")
                            </span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Varış:</span>
                            <span class="@(Model.ActualArrival.HasValue ? "fw-bold text-success" : "text-muted fst-italic")">
                                @(Model.ActualArrival?.ToString("HH:mm") ?? "--:--")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="alert alert-secondary border-0">
                    <h6 class="alert-heading fw-bold"><i class="bi bi-chat-left-text me-2"></i>Notlar & Açıklamalar</h6>
                    <p class="mb-0 small">@Model.Description</p>
                </div>
            }
        </div>

    </div>
</div>

@functions {
    string GetStatusBadgeClass(TaskState status) => status switch
    {
        TaskState.Pending => "bg-warning text-dark",
        TaskState.Accepted => "bg-info text-dark",
        TaskState.InProgress => "bg-primary",
        TaskState.Completed => "bg-success",
        TaskState.Cancelled => "bg-danger",
        TaskState.Incomplete => "bg-secondary",
        _ => "bg-light text-dark"
    };
}