@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var currentArea = ViewContext.RouteData.Values["Area"]?.ToString();
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();

    // Sadece Area "Driver" ise aktif olur
    string IsActive(string controller, string action = "Index") =>
        (string.Equals(currentArea, "Driver", StringComparison.OrdinalIgnoreCase) &&
         string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
         string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}

<ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">

    <li class="nav-header text-uppercase text-secondary fw-bold mt-3" style="font-size: 0.75rem; letter-spacing: 1px;">
        SÜRÜCÜ İŞLEMLERİ
    </li>

    <li class="nav-item">
        <a asp-area="Driver" asp-controller="Home" asp-action="Index" class="nav-link @IsActive("Home", "Index")">
            <i class="nav-icon bi bi-speedometer2 text-info"></i>
            <p>Panel (Dashboard)</p>
        </a>
    </li>

    <li class="nav-item">
        <a asp-area="Driver" asp-controller="Tasks" asp-action="Index" class="nav-link @IsActive("Tasks", "Index")">
            <i class="nav-icon bi bi-signpost-split text-primary"></i>
            <p>Seferlerim</p>
        </a>
    </li>
</ul>