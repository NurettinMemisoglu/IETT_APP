@using IETT_APP.WebMVC.Areas.Driver.Models
@model DriverProfileViewModel

<style>
    /* Bilgi Kutucukları - STATİK (Tıklanmaz) */
    .profile-info-box {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 15px;
        height: 100%;
        display: flex;
        align-items: center;
        /* cursor: default ile tıklanmaz hissi veriyoruz */
        cursor: default;
    }

        /* Sadece 'clickable' sınıfı alanlar hareket etsin */
        .profile-info-box.clickable {
            cursor: pointer;
            transition: transform 0.2s, border-color 0.2s;
        }

            .profile-info-box.clickable:hover {
                transform: translateY(-3px);
                border-color: #dc3545; /* Acil durum rengi */
                box-shadow: 0 5px 15px rgba(220, 53, 69, 0.1);
            }

    .profile-icon {
        width: 45px;
        height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin-right: 15px;
        flex-shrink: 0;
    }

    .text-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #6c757d;
        font-weight: 700;
        display: block;
        margin-bottom: 2px;
    }

    .text-value {
        font-size: 1rem;
        font-weight: 600;
        color: #212529;
        word-break: break-word;
    }
</style>

<div class="mb-4">
    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-person-lines-fill me-2"></i> İletişim Bilgileri</h5>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="profile-info-box">
                <div class="profile-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-telephone-fill"></i></div>
                <div>
                    <span class="text-label">Telefon</span>
                    <span class="text-value">@Model.PhoneNumber</span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="profile-info-box">
                <div class="profile-icon bg-info bg-opacity-10 text-info"><i class="bi bi-envelope-fill"></i></div>
                <div>
                    <span class="text-label">E-Posta</span>
                    <span class="text-value">@Model.Email</span>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="profile-info-box">
                <div class="profile-icon bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-geo-alt-fill"></i></div>
                <div>
                    <span class="text-label">Adres</span>
                    <span class="text-value">@(Model.Address ?? "Adres bilgisi girilmemiş.")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mb-4">
    <h5 class="fw-bold text-danger mb-3"><i class="bi bi-exclamation-triangle-fill me-2"></i> Acil Durum</h5>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="profile-info-box border-danger border-opacity-25 bg-danger bg-opacity-10">
                <div class="profile-icon bg-white text-danger"><i class="bi bi-person-heart"></i></div>
                <div>
                    <span class="text-label text-danger">İlgili Kişi</span>
                    <span class="text-value">@(Model.EmergencyContactName ?? "-")</span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="profile-info-box clickable border-danger border-opacity-25 bg-danger bg-opacity-10 position-relative">
                <div class="profile-icon bg-white text-danger"><i class="bi bi-telephone-plus-fill"></i></div>
                <div>
                    <span class="text-label text-danger">Acil İletişim (Ara)</span>
                    @if (!string.IsNullOrEmpty(Model.EmergencyContactPhone))
                    {
                        <a href="tel:@Model.EmergencyContactPhone" class="text-value text-decoration-none stretched-link text-dark">
                            @Model.EmergencyContactPhone
                        </a>
                    }
                    else
                    {
                        <span class="text-value">-</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mb-4">
    <h5 class="fw-bold text-success mb-3"><i class="bi bi-heart-pulse-fill me-2"></i> Sağlık Bilgileri</h5>
    <div class="row g-3">
        <div class="col-6 col-md-4">
            <div class="profile-info-box">
                <div class="profile-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-droplet-fill"></i></div>
                <div>
                    <span class="text-label">Kan Grubu</span>
                    @{
                        // Model'deki değeri string'e çeviriyoruz ("3" gibi)
                        var currentVal = Model.BloodType.ToString();

                        // Enum listesindeki Value (string) ile Modeldeki değeri (string) karşılaştırıyoruz
                        var bloodTypeText = Html.GetEnumSelectList<IETT_APP.Domain.Enums.BloodType>()
                        .FirstOrDefault(x => x.Value == currentVal)?.Text
                        ?? Model.BloodType.ToString();
                    }
                    <span class="badge bg-danger rounded-pill">@bloodTypeText</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="profile-info-box">
                <div class="profile-icon bg-success bg-opacity-10 text-success"><i class="bi bi-activity"></i></div>
                <div>
                    <span class="text-label">Kronik Hastalık</span>
                    @if (Model.HasChronicDisease)
                    {
                        <span class="badge bg-warning text-dark">VAR</span>
                    }
                    else
                    {
                        <span class="badge bg-success">YOK</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <div class="p-3 bg-light rounded border border-start-4 border-start-success">
                <h6 class="fw-bold text-success mb-1"><i class="bi bi-clipboard2-pulse me-2"></i>Sağlık Notları</h6>
                <p class="mb-0 text-muted small fst-italic">@(string.IsNullOrEmpty(Model.HealthNotes) ? "Özel bir sağlık notu bulunmamaktadır." : Model.HealthNotes)</p>
            </div>
        </div>
    </div>
</div>

<div class="text-end border-top pt-3">
    <button type="button" class="btn btn-outline-primary rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#updateProfileModal">
        <i class="bi bi-pencil-square me-1"></i> Bilgilerimi Güncelle
    </button>
</div>