@using IETT_APP.WebMVC.Areas.Driver.Models
@using IETT_APP.Domain.Enums
@model DriverProfileViewModel

<style>
    /* Bölüm Başlıkları: Renkli Arka Plan Yerine Sade Metin */
    .section-title {
        font-size: 0.9rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: center;
    }

        .section-title i {
            font-size: 1.1rem;
            margin-right: 8px;
        }

    /* Input Grubu İkonları */
    .input-group-text {
        background-color: #f8f9fa;
        border-right: none;
        color: #6c757d;
        min-width: 45px;
        justify-content: center;
    }

    .form-control, .form-select {
        border-left: none;
        background-color: #fff;
    }

        .form-control:focus, .form-select:focus {
            border-color: #dee2e6; /* Focus olduğunda standart renk */
            box-shadow: none; /* Gölgeyi kaldır */
            border-bottom: 2px solid #0d6efd; /* Sadece alt çizgi mavi olsun */
        }
</style>

<div class="mb-4">
    <div class="section-title text-primary">
        <i class="bi bi-person-lines-fill"></i> İletişim Bilgileri
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="PhoneNumber" class="form-label small fw-bold text-muted">Telefon</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-telephone text-primary"></i></span>
                <input asp-for="PhoneNumber" class="form-control" placeholder="05XX..." />
            </div>
            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Email" class="form-label small fw-bold text-muted">E-Posta</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope text-primary"></i></span>
                <input asp-for="Email" class="form-control" placeholder="ornek@iett.gov.tr" />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="col-12">
            <label asp-for="Address" class="form-label small fw-bold text-muted">Adres</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-geo-alt text-primary"></i></span>
                <textarea asp-for="Address" class="form-control" rows="2" placeholder="Açık adresiniz..."></textarea>
            </div>
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>
    </div>
</div>

<div class="mb-4">
    <div class="section-title text-danger">
        <i class="bi bi-exclamation-triangle-fill"></i> Acil Durum
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="EmergencyContactName" class="form-label small fw-bold text-muted">İlgili Kişi</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person-heart text-danger"></i></span>
                <input asp-for="EmergencyContactName" class="form-control" placeholder="Ad Soyad" />
            </div>
            <span asp-validation-for="EmergencyContactName" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="EmergencyContactPhone" class="form-label small fw-bold text-muted">Yakın Telefonu</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-telephone-plus text-danger"></i></span>
                <input asp-for="EmergencyContactPhone" class="form-control" placeholder="05XX..." />
            </div>
            <span asp-validation-for="EmergencyContactPhone" class="text-danger small"></span>
        </div>
    </div>
</div>

<div class="mb-3">
    <div class="section-title text-success">
        <i class="bi bi-heart-pulse-fill"></i> Sağlık Bilgileri
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="BloodType" class="form-label small fw-bold text-muted">Kan Grubu</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-droplet-fill text-success"></i></span>
                <select asp-for="BloodType" class="form-select" asp-items="Html.GetEnumSelectList<BloodType>()">
                    <option value="">Seçiniz</option>
                </select>
            </div>
            <span asp-validation-for="BloodType" class="text-danger small"></span>
        </div>

        <div class="col-12 mt-4">
            <div class="p-3 rounded-3 border bg-light" style="border-style: dashed !important;">

                <div class="form-check form-switch d-flex align-items-center">
                    <input asp-for="HasChronicDisease" class="form-check-input fs-5 me-3" type="checkbox" id="chronicCheck" style="cursor: pointer;">

                    <label class="form-check-label fw-bold text-danger mb-0" for="chronicCheck" style="cursor: pointer;">
                        Kronik bir rahatsızlığınız var mı?
                    </label>
                </div>

                <div id="chronicDetails" class="mt-3" style="display:none;">
                    <label asp-for="HealthNotes" class="form-label small fw-bold text-secondary">RAHATSIZLIK DETAYI</label>

                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-clipboard2-pulse text-danger"></i></span>
                        <textarea asp-for="HealthNotes" name="HealthNotes" class="form-control" rows="3" placeholder="Lütfen rahatsızlığınızı kısaca açıklayınız..."></textarea>
                    </div>
                    <span asp-validation-for="HealthNotes" class="text-danger small"></span>
                </div>

            </div>
        </div>
    </div>
</div>