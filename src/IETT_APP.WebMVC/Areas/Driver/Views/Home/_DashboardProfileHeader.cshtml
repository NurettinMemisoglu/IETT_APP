@using IETT_APP.Domain.Enums
@using IETT_APP.Application.Dtos.Driver
@model DriverDashboardDto

@{
    var apiRoot = "https://localhost:7254";
    string dashboardProfileImg = "/assets/img/user2-160x160.jpg";

    if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
    {
        if (Model.ProfileImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            dashboardProfileImg = Model.ProfileImageUrl.Contains(":7060")
                ? Model.ProfileImageUrl.Replace(":7060", ":7254")
                : Model.ProfileImageUrl;
        }
        else
        {
            var cleanPath = Model.ProfileImageUrl.StartsWith("/") ? Model.ProfileImageUrl : "/" + Model.ProfileImageUrl;
            dashboardProfileImg = $"{apiRoot}{cleanPath}";
        }
    }
}

<div class="profile-header-card p-3 mb-4 d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-3">
        <div class="position-relative">
            <img src="@dashboardProfileImg" class="rounded-circle shadow-sm border border-2 border-white user-image-live" style="width: 60px; height: 60px; object-fit: cover;" onerror="this.src='/assets/img/user2-160x160.jpg';" />

            @* WorkStatus Enum kontrolü *@
            <span class="position-absolute bottom-0 end-0 p-2 border border-white rounded-circle @(Model.WorkStatus == WorkStatus.Working ? "bg-success" : "bg-warning")"></span>
        </div>
        <div>
            <h5 class="fw-bold mb-0 text-dark">@Model.FullName</h5>
            <small class="text-muted"><i class="bi bi-person-badge me-1"></i> @Model.ShiftStatusText</small>
        </div>
    </div>
    <div class="text-end d-none d-sm-block px-3 border-start">
        <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem; letter-spacing: 1px;">Tamamlanan</small>
        <span class="fs-4 fw-bold text-dark">@Model.CompletedTasksCount</span> <small class="text-muted">Sefer</small>
    </div>
</div>