@using System.Globalization
@using IETT_APP.Domain.Enums
@using IETT_APP.Application.Dtos.Driver
@model IEnumerable<DashboardTaskDto>

@{
    var culture = new CultureInfo("tr-TR");
}

@if (Model != null && Model.Any())
{
    <h6 class="text-uppercase text-muted fw-bold small mb-4 ls-1 ps-2 mt-5">Haftalık Plan</h6>
    <div class="timeline ps-2">
        @foreach (var group in Model.GroupBy(t => t.TaskDate.Date))
        {
            string dayHeader = "";
            if (group.Key == DateTime.Today) { dayHeader = "Bugün"; }
            else if (group.Key == DateTime.Today.AddDays(1)) { dayHeader = "Yarın"; }
            else { dayHeader = group.Key.ToString("dd.MM.yyyy dddd", culture); }

            <div class="mb-3 position-relative">
                <span class="timeline-date-header shadow-sm"><i class="bi bi-calendar-event me-1"></i> @dayHeader</span>
            </div>

            @foreach (var task in group)
            {
                string borderClass = "border-accepted";
                string statusBadge = "<span class='badge bg-light text-primary border'>Kabul Edildi</span>";

                if (task.Status == TaskState.Pending)
                {
                    borderClass = "border-pending";
                    statusBadge = "<span class='badge bg-warning text-dark bg-opacity-25 border border-warning'>Bekliyor</span>";
                }
                else if (task.Status == TaskState.InProgress)
                {
                    borderClass = "border-inprogress";
                    statusBadge = "<span class='badge bg-info text-white'>Seferde</span>";
                }

                <div class="timeline-item pb-3 position-relative ps-4 border-start border-2 border-light">
                    <span class="position-absolute top-0 start-0 translate-middle bg-white border border-4 border-secondary rounded-circle" style="width: 14px; height: 14px; margin-top: 15px;"></span>
                    <div class="card timeline-card shadow-sm mb-2 @borderClass">
                        <div class="card-body p-3">
                            <div class="row align-items-center">
                                <div class="col-auto text-center pe-3 border-end">
                                    <span class="d-block h5 fw-bold mb-0 text-dark">@task.FormattedTime</span>
                                </div>
                                <div class="col">
                                    <div class="d-flex justify-content-between mb-1">
                                        <a href="/Driver/Tasks/Details/@task.Id" class="text-decoration-none text-dark">
                                            <h6 class="fw-bold mb-0">@task.LineCode <span class="fw-normal small ms-1 text-muted">@task.Title</span></h6>
                                        </a>
                                        <div>@Html.Raw(statusBadge)</div>
                                    </div>
                                    <div class="small text-muted text-truncate"><i class="bi bi-geo-alt me-1"></i> @task.RouteName</div>
                                </div>
                                @if (task.Status == TaskState.Pending)
                                {
                                    <div class="col-auto ps-2 border-start">
                                        <button class="btn btn-sm btn-light border rounded-circle btn-accept shadow-sm text-success" data-id="@task.Id" title="Hızlı Kabul">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="mb-4"></div>
        }
    </div>
}
else
{
    <div class="alert alert-light text-center border mt-3 rounded-3">
        <small class="text-muted">Önümüzdeki 7 gün için planlanmış başka görev yok.</small>
    </div>
}