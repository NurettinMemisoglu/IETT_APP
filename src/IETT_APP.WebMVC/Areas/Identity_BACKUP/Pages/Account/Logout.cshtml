@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
    Layout = null; // Login gibi bağımsız sayfa
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AdminLTE 4</title>

    <!-- AdminLTE ve Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/adminlte.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
</head>

<body class="register-page bg-body-secondary d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="logout-box">
        <div class="card card-outline card-primary shadow-sm" style="min-width: 380px;">
            <div class="card-header text-center">
                <h3 class="mb-0">@ViewData["Title"]</h3>
            </div>
            <div class="card-body text-center">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <p class="mb-3">You are currently logged in as <strong>@User.Identity?.Name</strong>.</p>
                    <form asp-area="" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                        <button type="submit" class="btn btn-danger w-100">
                            Log Out
                        </button>
                    </form>
                }
                else
                {
                    <p class="text-success">You have successfully logged out of the application.</p>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3 w-100">
                        Back to Home
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0/dist/js/adminlte.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
