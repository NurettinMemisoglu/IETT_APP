@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AdminLTE 4</title>

    <!-- AdminLTE ve Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/adminlte.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
</head>

<body class="register-page bg-body-secondary d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="login-box">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <a href="~/" class="h1"><b>IETT</b>APP</a>
            </div>
            <div class="card-body login-card-body">
                <p class="login-box-msg text-center">Sign in to start your session</p>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

                    <!-- Email -->
                    <div class="input-group mb-3">
                        <div class="form-floating flex-grow-1">
                            <input asp-for="Input.Email" class="form-control" placeholder="Email" autocomplete="username" />
                            <label asp-for="Input.Email">Email</label>
                        </div>
                        <div class="input-group-text">
                            <span class="bi bi-envelope"></span>
                        </div>
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>

                    <!-- Password -->
                    <div class="input-group mb-3">
                        <div class="form-floating flex-grow-1">
                            <input asp-for="Input.Password" class="form-control" placeholder="Password" autocomplete="current-password" />
                            <label asp-for="Input.Password">Password</label>
                        </div>
                        <div class="input-group-text">
                            <span class="bi bi-lock-fill"></span>
                        </div>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>

                    <!-- Remember Me ve Submit -->
                    <div class="row mb-3">
                        <div class="col-8 d-inline-flex align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label asp-for="Input.RememberMe" class="form-check-label">
                                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                                </label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary w-100">Sign In</button>
                            </div>
                        </div>
                    </div>
                </form>

                <!-- External Logins -->
                @if (Model.ExternalLogins?.Count > 0)
                {
                    <div class="social-auth-links text-center mb-3 d-grid gap-2">
                        <p>- OR -</p>
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                <button type="submit" name="provider" value="@provider.Name" class="btn btn-outline-primary w-100 mb-2">
                                    <i class="bi bi-box-arrow-in-right me-2"></i> Log in with @provider.DisplayName
                                </button>
                            </form>
                        }
                    </div>
                }

                <div class="text-center">
                    <p class="mb-1"><a asp-page="./ForgotPassword">I forgot my password</a></p>
                    <p class="mb-0">
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register a new membership</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0/dist/js/adminlte.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
