@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AdminLTE 4</title>

    <!-- AdminLTE & Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/adminlte.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
</head>

<body class="register-page bg-body-secondary d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="register-box">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <a href="~/" class="h1"><b>IETT</b>APP</a>
            </div>
            <div class="card-body register-card-body">
                <p class="login-box-msg">Register a new membership</p>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <input asp-for="FromAdmin" type="hidden" />

                    <!-- Full Name -->
                    <div class="input-group mb-3">
                        <input asp-for="Input.FullName" class="form-control" placeholder="Full Name" autocomplete="name" />
                        <div class="input-group-text">
                            <span class="bi bi-person"></span>
                        </div>
                    </div>
                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>

                    <!-- Email -->
                    <div class="input-group mb-3">
                        <input asp-for="Input.Email" class="form-control" placeholder="Email" autocomplete="username" />
                        <div class="input-group-text">
                            <span class="bi bi-envelope"></span>
                        </div>
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>

                    <!-- Password -->
                    <div class="input-group mb-3">
                        <input asp-for="Input.Password" class="form-control" placeholder="Password" autocomplete="new-password" />
                        <div class="input-group-text">
                            <span class="bi bi-lock-fill"></span>
                        </div>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>

                    <!-- Confirm Password -->
                    <div class="input-group mb-3">
                        <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Confirm Password" autocomplete="new-password" />
                        <div class="input-group-text">
                            <span class="bi bi-lock-fill"></span>
                        </div>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>

                    <!-- Terms + Submit -->
                    <div class="row">
                        <div class="col-8">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="agreeTerms" required />
                                <label class="form-check-label" for="agreeTerms">
                                    I agree to the <a href="#">terms</a>
                                </label>
                            </div>
                        </div>
                        <div class="col-4">
                            <button id="registerSubmit" type="submit" class="btn btn-primary btn-block">Register</button>
                        </div>
                    </div>
                </form>

                <!-- External Logins -->
                @if (Model.ExternalLogins?.Count > 0)
                {
                    <div class="social-auth-links text-center mb-3 mt-3">
                        <p>- OR -</p>
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mb-2">
                                <button type="submit" name="provider" value="@provider.Name" class="btn btn-outline-primary w-100">
                                    <i class="bi bi-box-arrow-in-right me-2"></i> Register with @provider.DisplayName
                                </button>
                            </form>
                        }
                    </div>
                }

                <p class="mb-0 text-center">
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-center">
                        I already have a membership
                    </a>
                </p>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/admin-lte/dist/js/adminlte.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
