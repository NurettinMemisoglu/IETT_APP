@model IEnumerable<IETT_APP.WebMVC.Areas.Planner.Models.LineViewModel>

@{
    ViewData["Title"] = "Hat Yönetimi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/planner-lines.css" asp-append-version="true" />
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="m-0 fw-bold text-dark">
            <i class="bi bi-bezier2 text-primary me-2"></i> Hat Yönetimi
        </h3>
        <button id="addLineBtn" class="btn btn-success fw-bold px-4 py-2">
            <i class="bi bi-plus-lg me-1"></i> Yeni Hat Ekle
        </button>
    </div>

    <div class="search-bar-container">
        <div class="p-2 bg-white rounded shadow-sm border">
            <div class="input-group input-group-sm" style="width: 300px;">
                <span class="input-group-text bg-light border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="searchInput" class="form-control border-start-0" placeholder="Hat adı veya kodu ara..." autocomplete="off" />
            </div>
        </div>
    </div>

    <div class="table-card mt-3">
        <div id="linesTableContainer">
            <partial name="_LinesTablePartial" model="Model" />
        </div>
    </div>

    <partial name="_LineModalPartial" />
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}