@model IETT_APP.WebMVC.Areas.Planner.Models.LineViewModel

<h2>@(Model.Id == Guid.Empty ? "Yeni Hat" : "Hat Düzenle")</h2>

<div class="container mt-4">


    <form asp-action="@((Model.Id == Guid.Empty) ? "Create" : "Edit")" method="post">
        <partial name="_LineFormPartial" model="Model" />

        <button type="submit" class="btn btn-success mt-2">
            @(Model.Id == Guid.Empty ? "Kaydet" : "Güncelle")
        </button>
    </form>

</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
