@using IETT_APP.WebMVC.Extensions
@model IEnumerable<IETT_APP.WebMVC.Areas.Planner.Models.LineViewModel>

<div class="card">
    <div class="card-body table-responsive p-0">
        <table class="table table-hover table-striped text-nowrap">
            <thead class="table-dark">
                <tr>
                    <th>Kod</th>
                    <th>Ad</th>
                    <th>Tip</th>
                    <th>Araç Sayısı</th>
                    <th>Durum</th>
                    <th>Oluşturulma Tarihi</th>
                    <th>Son Düzenlenme Tarihi</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr data-id="@item.Id">
                            <td class="line-code">@item.Code</td>
                            <td class="line-name">@item.Name</td>
                            <td class="line-type" data-value="@((int)item.LineType)">
                                @item.LineType.ToDisplayName()
                            </td>
                            <td class="line-vehicleCount">@item.VehicleCount</td>
                            <td>
                                <button class="toggle-line-active"
                                        data-toggle-id="@item.Id"
                                        data-active="@item.IsActive.ToString().ToLower()"
                                        style="min-width: 50px; padding: 0; border: none; background: transparent; cursor: pointer;">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success rounded-pill" style="font-size: 0.8rem; padding: 0.35rem 0.75rem; transition: transform 0.1s;">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill" style="font-size: 0.8rem; padding: 0.35rem 0.75rem; transition: transform 0.1s;">Pasif</span>
                                    }
                                </button>
                            </td>
                            <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@item.UpdatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <button class="btn btn-sm btn-warning edit-line" data-id="@item.Id" title="Düzenle">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-danger delete-line" data-id="@item.Id" title="Sil">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">Kayıtlı hat bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
