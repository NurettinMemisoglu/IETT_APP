@model IETT_APP.WebMVC.Areas.Planner.Models.LineViewModel

<div class="routes-form-wrapper border-0 shadow-none">

    <form id="lineForm">
        <input type="hidden" id="Id" name="Id" value="@Model.Id" />

        <div class="row">
            <div class="col-12">

                <h5 class="routes-section-header mb-4">
                    <i class="bi bi-info-circle me-1"></i> Hat Temel Bilgileri
                </h5>

                <div class="form-floating mb-3">
                    <input asp-for="Code" id="Code" class="form-control" placeholder="Kod" />
                    <label asp-for="Code">Hat Kodu</label>
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Name" id="Name" class="form-control" placeholder="Ad" />
                    <label asp-for="Name">Hat Adı</label>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="row g-2">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <select asp-for="LineType" class="form-select" asp-items="ViewBag.LineTypeList">
                                <option value="">-- Hat Tipi Seçin --</option>
                            </select>
                            <label asp-for="LineType">Hat Tipi</label>
                            <span asp-validation-for="LineType" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="VehicleCount" id="VehicleCount" class="form-control" type="number" placeholder="0" />
                            <label asp-for="VehicleCount">Araç Sayısı</label>
                            <span asp-validation-for="VehicleCount" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-check form-switch mb-3 p-3 bg-light rounded border d-flex justify-content-end align-items-center">
                    <label asp-for="IsActive" class="form-check-label fw-bold me-3 text-secondary" style="cursor: pointer;">Hat Aktif Durumu</label>
                    <input asp-for="IsActive" id="IsActive" class="form-check-input m-0" type="checkbox" style="cursor: pointer; transform: scale(1.2);" />
                </div>

            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                <i class="bi bi-x-lg me-1"></i> İptal
            </button>
            <button type="submit" class="btn btn-success px-4 fw-bold">
                <i class="bi bi-check-lg me-1"></i> Kaydet
            </button>
        </div>

    </form>
</div>