@model IETT_APP.WebMVC.Areas.Planner.Models.RouteViewModel
@{
    ViewData["Title"] = "Güzergah Düzenle";
}

@section Styles {
    <link rel="stylesheet" href="~/css/planner-routes.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12">

            <div class="card card-warning card-outline shadow-sm border-top-0" style="border-top: 3px solid #ffc107 !important;">

                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h3 class="card-title fw-bold text-warning m-0">
                        <i class="bi bi-pencil-square me-2"></i> Güzergah Düzenle
                    </h3>
                    <span class="badge bg-secondary">ID: @Model.Id.ToString().Substring(0, 8)...</span>
                </div>

                <div class="card-body bg-light">
                    <form id="routeForm" asp-action="Execute" method="post">
                        @await Html.PartialAsync("_RouteFormPartial", Model)
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        window.initialStops = @Html.Raw(Json.Serialize(Model.StopIds ?? new List<Guid>()));
        // Detaylı durak bilgisi varsa onu da al (ViewBag ile geliyorsa)
        // Eğer yoksa StopIds üzerinden JS load edecek
    </script>

    <script src="~/js/routes.js"></script>
    <script src="~/js/routes-map.js"></script>
}