@using IETT_APP.WebMVC.Extensions
@model IEnumerable<IETT_APP.WebMVC.Areas.Planner.Models.RouteViewModel>
@inject IETT_APP.WebMVC.Services.Interfaces.ILineApiService LineService
@inject IETT_APP.WebMVC.Services.Interfaces.IStopApiService StopService

<div class="card">
    <div class="card-body table-responsive p-0">
        <table class="table table-hover table-striped text-nowrap">
            <thead class="table-dark">
                <tr>
                    <th>Kod</th>
                    <th>Ad</th>
                    <th>Yön</th>
                    <th>Hat</th>
                    <th>Duraklar</th>
                    <th>Hat Uzunluğu(M)</th>
                    <th>Hat Süresi(DK)</th>
                    <th>Durum</th>
                    <th>Oluşturulma Tarihi</th>
                    <th>Son Düzenlenme Tarihi</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var lineName = !string.IsNullOrEmpty(item.LineName)
                            ? item.LineName
                            : LineService.GetByIdAsync(item.LineId).Result?.Name ?? "—";

                        var stopNames = item.StopIds != null && item.StopIds.Any()
                            ? item.StopIds.Select(id => StopService.GetByIdAsync(id.ToString()).Result?.Name ?? "—").ToList()
                            : new List<string>();

                        item.StopNames = stopNames;

                        var stopNamesJson = System.Text.Json.JsonSerializer.Serialize(item.StopNames);
                        var stopIdsJson = System.Text.Json.JsonSerializer.Serialize(item.StopIds);

                        <tr data-id="@item.Id">
                            <td class="route-code">@item.Code</td>
                            <td class="route-name">@item.Name</td>
                            <td class="route-direction" data-value="@((int)item.RoutesDirection)">
                                @item.RoutesDirection.ToDisplayName()
                            </td>
                            <td class="route-line" data-lineid="@item.LineId">@lineName</td>

                            <td>
                                @if (item.StopNames != null && item.StopNames.Any())
                                {
                                    <button class="btn btn-sm btn-outline-primary view-stops"
                                            data-stops='@stopNamesJson'
                                            data-stopids='@stopIdsJson'>
                                        Durakları Gör
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <td class="route-length">@item.LengthInM</td>
                            <td class="route-time">@item.TimeInMinutes</td>
                            <td>
                                <button class="toggle-route-active"
                                        data-id="@item.Id"
                                        data-active="@item.IsActive.ToString().ToLower()"
                                        style="min-width: 50px; padding: 0; border: none; background: transparent; cursor: pointer;">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success rounded-pill" style="font-size: 0.8rem; padding: 0.35rem 0.75rem;">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill" style="font-size: 0.8rem; padding: 0.35rem 0.75rem;">Pasif</span>
                                    }
                                </button>
                            </td>
                            <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@item.UpdatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <button class="btn btn-sm btn-warning edit-route" data-id="@item.Id" title="Düzenle" action="POST">
                                    <i class="fas fa-edit">Düzenle</i>
                                </button>
                                <button class="btn btn-sm btn-danger delete-route" data-id="@item.Id" title="Sil">
                                    <i class="fas fa-trash-alt">Sil</i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11" class="text-center text-muted">Kayıtlı rota bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
