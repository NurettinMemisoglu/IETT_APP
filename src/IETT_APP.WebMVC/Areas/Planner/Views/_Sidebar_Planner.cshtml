@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // 1. O anki Area, Controller ve Action bilgilerini alıyoruz
    var currentArea = ViewContext.RouteData.Values["Area"]?.ToString();
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();

    // 2. Area + Controller + Action kontrolü yapan fonksiyon
    // Sadece Area "Planner" ise aktif sınıfı döndürür.
    string IsActive(string controller, string action = "Index") =>
        (string.Equals(currentArea, "Planner", StringComparison.OrdinalIgnoreCase) &&
         string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
         string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}

<ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">

    <li class="nav-header text-uppercase text-secondary fw-bold mt-3" style="font-size: 0.75rem; letter-spacing: 1px;">
        PLANLAMA İŞLEMLERİ
    </li>

    <li class="nav-item">
        <a asp-area="Planner" asp-controller="Stops" asp-action="Index" class="nav-link @IsActive("Stops")">
            <i class="nav-icon bi bi-sign-stop text-danger"></i>
            <p>Duraklar</p>
        </a>
    </li>

    <li class="nav-item">
        <a asp-area="Planner" asp-controller="Routes" asp-action="Index" class="nav-link @IsActive("Routes")">
            <i class="nav-icon bi bi-map text-primary"></i>
            <p>Güzergahlar</p>
        </a>
    </li>

    <li class="nav-item">
        <a asp-area="Planner" asp-controller="Lines" asp-action="Index" class="nav-link @IsActive("Lines")">
            <i class="nav-icon bi bi-bezier2 text-success"></i>
            <p>Hatlar</p>
        </a>
    </li>

    <li class="nav-item">
        <a asp-area="Planner" asp-controller="Vehicles" asp-action="Index" class="nav-link @IsActive("Vehicles")">
            <i class="nav-icon bi bi-bus-front text-info"></i>
            <p>Araçlar</p>
        </a>
    </li>

    <li class="nav-item">
        <a asp-area="Planner" asp-controller="Drivers" asp-action="Index" class="nav-link @IsActive("Drivers")">
            <i class="nav-icon bi bi-person-badge text-light"></i>
            <p>Sürücüler & Atama</p>
        </a>
    </li>

</ul>