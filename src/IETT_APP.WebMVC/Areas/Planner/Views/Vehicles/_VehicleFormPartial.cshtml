@model IETT_APP.WebMVC.Areas.Planner.Models.VehicleViewModel

<form id="vehicleForm" method="post">
    <input type="hidden" id="Id" name="Id" value="@Model.Id" />


    <div class="form-floating mb-3">
        <input asp-for="DoorNumber" class="form-control" placeholder="Kapı Numarası" />
        <label asp-for="DoorNumber"></label>
        <span asp-validation-for="DoorNumber" class="text-danger"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="PlateNumber" class="form-control" placeholder="Plaka Numarası" />
        <label asp-for="PlateNumber"></label>
        <span asp-validation-for="PlateNumber" class="text-danger"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Capacity" class="form-control" type="number" placeholder="Kapasite" />
        <label asp-for="Capacity"></label>
        <span asp-validation-for="Capacity" class="text-danger"></span>
    </div>

    <!-- Garage Dropdown (JS ile yükleniyor) -->
    <div class="form-floating mb-3">
        <select asp-for="GarageId" id="GarageId" class="form-select"
                data-selected="@((Model.GarageId == null || Model.GarageId == Guid.Empty) ? string.Empty : Model.GarageId.ToString())">
            <option value="" disabled selected>-- Garaj Seçin --</option>
        </select>
        <label asp-for="GarageId"></label>
    </div>

    <!-- Service Status Dropdown -->
    <div class="form-floating mb-3">
        <select asp-for="ServiceStatus" class="form-select" asp-items="ViewBag.ServiceStatusList">
            <option value="" selected disabled>-- Servis Durumu Seçin --</option>
        </select>
        <label asp-for="ServiceStatus"></label>
        <span asp-validation-for="ServiceStatus" class="text-danger"></span>
    </div>

    <!-- Operator Dropdown -->
    <div class="form-floating mb-3">
        <select asp-for="Operator" class="form-select" asp-items="ViewBag.VehicleOperatorList">
            <option value="" selected disabled >-- Operatör Seçin --</option>
        </select>
        <label asp-for="Operator"></label>
        <span asp-validation-for="Operator" class="text-danger"></span>
    </div>

    <!-- Model Dropdown -->
    <div class="form-floating mb-3">
        <select asp-for="Model" class="form-select" asp-items="ViewBag.VehicleModelList">
            <option value="" selected disabled>-- Model Seçin --</option>
        </select>
        <label asp-for="Model"></label>
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Year" class="form-control" type="number" placeholder="Üretim Yılı" />
        <label asp-for="Year"></label>
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="TotalKm" class="form-control" type="number" placeholder="Toplam Kilometre" />
        <label asp-for="TotalKm"></label>
        <span asp-validation-for="TotalKm" class="text-danger"></span>
    </div>

    <div class="form-check form-switch mb-2">
        <input asp-for="HasDisabilityAccess" class="form-check-input" />
        <label asp-for="HasDisabilityAccess" class="form-check-label"></label>
    </div>

    <div class="form-check form-switch mb-2">
        <input asp-for="HasWiFi" class="form-check-input" />
        <label asp-for="HasWiFi" class="form-check-label"></label>
    </div>

    <div class="form-check form-switch mb-2">
        <input asp-for="HasBikeRack" class="form-check-input" />
        <label asp-for="HasBikeRack" class="form-check-label"></label>
    </div>

    <div class="form-check form-switch mb-2">
        <input asp-for="HasMobileCharging" class="form-check-input" />
        <label asp-for="HasMobileCharging" class="form-check-label"></label>
    </div>

    <div class="form-check form-switch mb-2">
        <input asp-for="HasPassengerInfoSystem" class="form-check-input" />
        <label asp-for="HasPassengerInfoSystem" class="form-check-label"></label>
    </div>

    <div class="form-check form-switch mb-3">
        <input asp-for="HasCCTV" class="form-check-input" />
        <label asp-for="HasCCTV" class="form-check-label"></label>
    </div>

    <div class="form-check form-switch mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>

    <div class="text-end mt-4">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <button type="button" class="btn btn-secondary" id="cancelVehicleBtn">İptal</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
