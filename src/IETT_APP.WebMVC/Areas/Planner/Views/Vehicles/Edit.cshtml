@model IETT_APP.WebMVC.Areas.Planner.Models.VehicleViewModel
@{
    ViewData["Title"] = "Araç Düzenle";
}

@section Styles {
    <link rel="stylesheet" href="~/css/planner-vehicles.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">

            <div class="card card-warning card-outline shadow-sm border-top-0" style="border-top: 3px solid #ffc107 !important;">

                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h3 class="card-title fw-bold text-warning m-0">
                        <i class="bi bi-pencil-square me-2"></i> Araç Düzenle
                    </h3>
                    <span class="badge bg-secondary font-monospace">
                        ID: @Model.Id.ToString().Substring(0, 8)...
                    </span>
                </div>

                <div class="card-body bg-light">
                    <form id="vehicleForm" asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        @await Html.PartialAsync("_VehicleFormPartial", Model)
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/vehicles.js"></script>
}