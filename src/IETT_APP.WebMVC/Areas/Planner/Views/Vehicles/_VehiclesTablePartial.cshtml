@using IETT_APP.WebMVC.Extensions
@model IEnumerable<IETT_APP.WebMVC.Areas.Planner.Models.VehicleViewModel>

<div class="card">
    <div class="card-body table-responsive p-0">
        <table class="table table-hover table-striped text-nowrap align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Kapı No</th>
                    <th>Plaka</th>
                    <th>Kapasite</th>
                    <th>Garaj</th>
                    <th>Servis Durumu</th>
                    <th>Operatör</th>
                    <th>Model</th>
                    <th>Yıl</th>
                    <th>Kilometre</th>
                    <th>Engelli</th>
                    <th>WiFi</th>
                    <th>Bisiklet</th>
                    <th>Şarj Ünitesi</th>
                    <th>Bilgi Sistemi</th>
                    <th>Kamera</th>
                    <th>Durum</th>
                    <th>Oluşturulma</th>
                    <th>Son Güncelleme</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr data-id="@item.Id">
                            <td>@item.DoorNumber</td>
                            <td>@item.PlateNumber</td>
                            <td>@item.Capacity</td>
                            <td>@item.GarageId</td>
                            <td>@item.ServiceStatus.ToDisplayName()</td>
                            <td>@item.Operator.ToDisplayName()</td>
                            <td>@item.Model.ToDisplayName()</td>
                            <td>@item.Year</td>
                            <td>@item.TotalKm</td>

                            <td>
                                @if (item.HasDisabilityAccess)
                                {
                                    <i class="fas fa-check text-success"></i>
                                }
                                else
                                {

                                    <i class="fas fa-times text-danger"></i>
                                }
                            </td>

                            <td>
                                @if (item.HasWiFi)
                                {
                                    <i class="fas fa-check text-success"></i>
                                }
                                else
                                {

                                    <i class="fas fa-times text-danger"></i>
                                }
                            </td>

                            <td>
                                @if (item.HasBikeRack)
                                {
                                    <i class="fas fa-check text-success"></i>
                                }
                                else
                                {

                                    <i class="fas fa-times text-danger"></i>
                                }
                            </td>

                            <td>
                                @if (item.HasMobileCharging)
                                {
                                    <i class="fas fa-check text-success"></i>
                                }
                                else
                                {

                                    <i class="fas fa-times text-danger"></i>
                                }
                            </td>

                            <td>
                                @if (item.HasPassengerInfoSystem)
                                {
                                    <i class="fas fa-check text-success"></i>
                                }
                                else
                                {

                                    <i class="fas fa-times text-danger"></i>
                                }
                            </td>

                            <td>
                                @if (item.HasCCTV)
                                {
                                    <i class="fas fa-check text-success"></i>
                                }
                                else
                                {

                                    <i class="fas fa-times text-danger"></i>
                                }
                            </td>

                            <td>
                                <button class="toggle-vehicle-active"
                                        data-id="@item.Id"
                                        data-active="@item.IsActive.ToString().ToLower()"
                                        style="min-width: 50px; padding: 0; border: none; background: transparent; cursor: pointer;">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success rounded-pill" style="font-size: 0.8rem; padding: 0.35rem 0.75rem;">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill" style="font-size: 0.8rem; padding: 0.35rem 0.75rem;">Pasif</span>
                                    }
                                </button>
                            </td>

                            <td>@item.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@item.UpdatedAt?.ToString("yyyy-MM-dd HH:mm")</td>

                            <td>
                                <button class="btn btn-sm btn-warning edit-vehicle" data-id="@item.Id" title="Düzenle">
                                    <i class="fas fa-edit"></i> Düzenle
                                </button>
                                <button class="btn btn-sm btn-danger delete-vehicle" data-id="@item.Id" title="Sil">
                                    <i class="fas fa-trash-alt"></i> Sil
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="19" class="text-center text-muted">Kayıtlı araç bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
