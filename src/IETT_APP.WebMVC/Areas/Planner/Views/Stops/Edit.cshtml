@model IETT_APP.WebMVC.Areas.Planner.Models.StopViewModel

@{
    ViewData["Title"] = "Durak Düzenle";
}

<div class="container-fluid mt-4">
    <div class="card card-warning card-outline shadow-sm">
        <div class="card-header">
            <h3 class="card-title fw-bold">
                <i class="bi bi-pencil-square me-2"></i> Durak Düzenle
            </h3>
            <div class="card-tools">
                <span class="badge bg-secondary">ID: @Model.Id.ToString().Substring(0, 8)...</span>
            </div>
        </div>
        <div class="card-body">

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @await Html.PartialAsync("_StopFormPartial", Model)

                <div class="row mt-4">
                    <div class="col-12 text-end">
                        <a asp-action="Index" asp-controller="Stops" asp-area="Planner" class="btn btn-secondary me-2">
                            <i class="bi bi-x-lg"></i> İptal
                        </a>

                        <button type="submit" class="btn btn-warning px-4 text-dark fw-bold">
                            <i class="bi bi-check-lg"></i> Değişiklikleri Kaydet
                        </button>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const latitudeInput = document.querySelector('input[name="Location.Latitude"]');
            const longitudeInput = document.querySelector('input[name="Location.Longitude"]');

            [latitudeInput, longitudeInput].forEach(input => {
                input.addEventListener("input", function() {
                    // Sadece rakam, - ve , karakterlerine izin ver
                    this.value = this.value.replace(/[^\d.-]/g, "");
                    // Max 6 ondalık basamak
                    const parts = this.value.split(",");
                    if(parts[1] && parts[1].length > 6) {
                        parts[1] = parts[1].substring(0,6);
                        this.value = parts.join(",");
                    }
                });
            });
        });
    </script>
}
