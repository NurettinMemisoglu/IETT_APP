@model IETT_APP.WebMVC.Areas.Planner.Models.StopViewModel
@{
    ViewData["Title"] = "Yeni Durak Ekle";
}

<div class="container mt-4">
    <h2 class="mb-3">Yeni Durak Ekle</h2>

    <form asp-action="Create" method="post">
        @await Html.PartialAsync("_StopFormPartial", Model)

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">
                Kaydet
            </button>
            <button type="submit"
                    formaction="@Url.Action("Index", "Home", new { area = "Planner" })"
                    formmethod="get"
                    class="btn btn-secondary">
                İptal
            </button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
