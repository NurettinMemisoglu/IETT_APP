@using System.Text.Json
@model IETT_APP.WebMVC.Areas.Planner.Models.StopViewModel

<div class="form-floating mb-3">
    <input asp-for="Code" class="form-control" placeholder="Kod" />
    <label asp-for="Code">Kod</label>
    <span asp-validation-for="Code" class="text-danger"></span>
</div>

<div class="form-floating mb-3">
    <input asp-for="Name" class="form-control" placeholder="Adı" />
    <label asp-for="Name">Adı</label>
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="form-floating mb-3 position-relative">
    <input asp-for="District" id="DistrictInput"
           class="form-control" placeholder="İlçe seçin veya yazın" autocomplete="off" />
    <label for="DistrictInput">İlçe</label>
    <span asp-validation-for="District" class="text-danger"></span>

    <script type="application/json" id="districtData">
        @Html.Raw(JsonSerializer.Serialize(((List<SelectListItem>)ViewBag.DistrictList).Select(d => d.Value)))
    </script>
</div>


<!-- StopType Dropdown -->
<div class="form-floating mb-3">
    <select asp-for="StopType" class="form-select" asp-items="ViewBag.StopTypeList">
        <option value="">-- Durak Tipi Seçin --</option>
    </select>
    <label asp-for="StopType">Durak Tipi</label>
    <span asp-validation-for="StopType" class="text-danger"></span>
</div>

<!-- SmartStop Dropdown -->
<div class="form-floating mb-3">
    <select asp-for="SmartStop" class="form-select" asp-items="ViewBag.SmartStopList">
        <option value="">-- Seçiniz --</option>
    </select>
    <label asp-for="SmartStop">Akıllı Durak</label>
    <span asp-validation-for="SmartStop" class="text-danger"></span>
</div>

<h5 class="mt-3">Konum</h5>
<div class="row">
    <div class="col-md-6 form-floating mb-3">
        <input asp-for="Location.Latitude"
               type="text"
               class="form-control"
               placeholder="Enlem (ör: 41,087074)"
               inputmode="decimal"
               pattern="[0-9\.,\-]+" />
        <label asp-for="Location.Latitude">Enlem</label>
        <span asp-validation-for="Location.Latitude" class="text-danger"></span>
    </div>
    <div class="col-md-6 form-floating mb-3">
        <input asp-for="Location.Longitude"
               type="text"
               class="form-control"
               placeholder="Boylam (ör: 29,007086)"
               inputmode="decimal"
               pattern="[0-9\.,\-]+" />
        <label asp-for="Location.Longitude">Boylam</label>
        <span asp-validation-for="Location.Longitude" class="text-danger"></span>
    </div>
</div>


<!-- 🌍 Harita Bölümü -->
<h5 class="mt-4">Harita Üzerinden Konum Seçimi</h5>
<div class="map-container mb-4">
    <div id="map"></div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            function normalizeDecimalString(s) {
                if (!s) return "";
                s = s.replace(',', '.').trim();

                // Sadece sayı, nokta ve eksi izinli
                s = s.replace(/[^0-9.\-]/g, "");

                // Birden fazla nokta varsa yalnızca ilkini koru
                const firstDot = s.indexOf(".");
                if (firstDot !== -1) {
                    s = s.substring(0, firstDot + 1) + s.substring(firstDot + 1).replace(/\./g, "");
                }

                // 20,18 sınırı uygula (max 2 tam, 18 ondalık basamak)
                const parts = s.split(".");
                if (parts[0].length > 2) parts[0] = parts[0].substring(0, 2);
                if (parts[1] && parts[1].length > 6) parts[1] = parts[1].substring(0,6);

                return parts.join(".");
            }

            document.addEventListener('DOMContentLoaded', function () {
                const latSelector = 'input[name="Location.Latitude"], input[name$=".Location.Latitude"]';
                const lonSelector = 'input[name="Location.Longitude"], input[name$=".Location.Longitude"]';
                const forms = document.querySelectorAll('form');

                forms.forEach(form => {
                    const lat = form.querySelector(latSelector);
                    const lon = form.querySelector(lonSelector);

                    if (lat) {
                        lat.addEventListener('input', () => lat.value = normalizeDecimalString(lat.value));
                        lat.addEventListener('blur', () => lat.value = normalizeDecimalString(lat.value));
                    }
                    if (lon) {
                        lon.addEventListener('input', () => lon.value = normalizeDecimalString(lon.value));
                        lon.addEventListener('blur', () => lon.value = normalizeDecimalString(lon.value));
                    }

                    // Form gönderilmeden önce değerleri normalize et
                    form.addEventListener('submit', () => {
                        if (lat) lat.value = normalizeDecimalString(lat.value);
                        if (lon) lon.value = normalizeDecimalString(lon.value);
                    });
                });
            });
        })();
    </script>
}
