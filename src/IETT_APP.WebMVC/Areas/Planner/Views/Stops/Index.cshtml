@using IETT_APP.WebMVC.Extensions
@model IEnumerable<IETT_APP.WebMVC.Areas.Planner.Models.StopViewModel>
@{
    ViewData["Title"] = "Durak Yönetimi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/planner-stops.css" asp-append-version="true" />
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="m-0 fw-bold text-dark"><i class="bi bi-list-task text-primary me-2"></i> Durak Yönetimi</h3>
        <a asp-area="Planner" asp-controller="Stops" asp-action="Create" class="btn btn-success fw-bold px-4 py-2 me-2">
            <i class="bi bi-plus-lg me-1"></i> Yeni Durak Ekle
        </a>
    </div>

    <div class="search-bar-container">
        <div class="p-2 bg-white">
            <div class="input-group input-group-sm" style="width: 300px;">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>

                <input type="text" id="searchInput" class="form-control border-start-0" placeholder="Listede ara..." autocomplete="off" />
            </div>
        </div>
    </div>

    <div class="table-card mt-3">
        <div id="stopsTableContainer">
            <partial name="_StopTablePartial" model="Model" />
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/stops.js" asp-append-version="true"></script>
}