@using IETT_APP.WebMVC.Extensions
@model IEnumerable<IETT_APP.WebMVC.Areas.Planner.Models.StopViewModel>
@{
    ViewData["Title"] = "Durak Yönetimi";
}

<div class="container mt-4">
    <h2 class="mb-3">Durak Listesi</h2>

    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Durak ara..." />
            <button type="submit" class="btn btn-primary">Ara</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
        </div>
    </form>

    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Kod</th>
                <th>Adı</th>
                <th>İlçe</th>
                <th>Durak Türü</th>
                <th>Akıllı Durak</th>
                <th>Enlem</th>
                <th>Boylam</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var stop in Model)
                {
                    <tr>
                        <td>@stop.Code</td>
                        <td>@stop.Name</td>
                        <td>@stop.District</td>
                        <td>@stop.StopType.ToDisplayName()</td>
                        <td>@stop.SmartStop.ToDisplayName()</td>
                        <td>@stop.Location.Latitude</td>
                        <td>@stop.Location.Longitude</td>
                        <td class="d-flex gap-2">
                            <a asp-area="Planner" asp-controller="Stops" asp-action="Edit" asp-route-id="@stop.Id" class="btn btn-warning btn-sm">Düzenle</a>
                            <a asp-area="Planner" asp-controller="Stops" asp-action="Details" asp-route-id="@stop.Id" class="btn btn-info btn-sm">Detay</a>
                            <form asp-area="Planner" asp-controller="Stops" asp-action="Delete" asp-route-id="@stop.Id" method="post" onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">Kayıtlı durak bulunamadı.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <a asp-area="Planner" asp-controller="Stops" asp-action="Create" class="btn btn-success">Yeni Durak Ekle</a>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/maps.css" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

}