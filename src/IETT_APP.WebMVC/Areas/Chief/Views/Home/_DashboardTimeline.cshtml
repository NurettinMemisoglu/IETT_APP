@using IETT_APP.Domain.Enums
@using IETT_APP.WebMVC.Areas.Chief.Models
@model List<TimelineItemViewModel>

<div class="card border-0 shadow-sm rounded-4 h-100">
    <div class="card-header bg-white border-0 py-3 px-4 rounded-top-4 d-flex align-items-center">
        <div class="bg-light rounded-circle p-2 me-2 text-primary"><i class="bi bi-activity"></i></div>
        <h5 class="fw-bold mb-0">Canlı Operasyon Akışı</h5>
    </div>

    <div class="card-body px-4 py-4 bg-light bg-opacity-25 rounded-bottom-4" style="max-height: 650px; overflow-y: auto;">

        @if (Model != null && Model.Any())
        {
            <div class="timeline-modern ms-2">
                @foreach (var item in Model)
                {
                    // Stil Değişkenleri
                    string dotColor = "#adb5bd";
                    string cardBorderLeft = "4px solid #adb5bd";
                    string timeColor = "text-muted";
                    string statusBadge = "";
                    bool isPulsing = false;

                    if (item.Status == TaskState.Completed)
                    {
                        dotColor = "#198754";
                        cardBorderLeft = "4px solid #198754";
                        statusBadge = "<span class='badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill'>Tamamlandı</span>";
                    }
                    else if (item.Status == TaskState.InProgress)
                    {
                        dotColor = "#0dcaf0";
                        cardBorderLeft = "4px solid #0dcaf0";
                        timeColor = "text-info fw-bold";
                        statusBadge = "<span class='badge bg-info text-white rounded-pill px-3'><i class='bi bi-broadcast me-1'></i> Seferde</span>";
                    }
                    else if (item.Status == TaskState.Cancelled || item.Status == TaskState.Incomplete)
                    {
                        dotColor = "#dc3545";
                        cardBorderLeft = "4px solid #dc3545";
                        isPulsing = true;
                        statusBadge = "<span class='badge bg-danger rounded-pill'>İPTAL / SORUN</span>";
                    }
                    else if (item.IsDelayed)
                    {
                        dotColor = "#ffc107";
                        cardBorderLeft = "4px solid #ffc107";
                        isPulsing = true;
                        statusBadge = "<span class='badge bg-warning text-dark rounded-pill'>Gecikme</span>";
                    }
                    else
                    {
                        statusBadge = "<span class='badge bg-light text-secondary border rounded-pill'>Bekliyor</span>";
                    }

                    <div class="timeline-item-modern">
                        <div class="timeline-dot @(isPulsing ? "pulse-red" : "")" style="background-color: @dotColor; box-shadow: 0 0 0 4px #fff, 0 0 0 6px @dotColor;"></div>

                        <div class="card timeline-card p-3" style="border-left: @cardBorderLeft;">
                            <div class="d-flex justify-content-between align-items-center">

                                <div class="d-flex align-items-center">
                                    <div class="text-center me-3 pe-3 border-end">
                                        <h5 class="mb-0 fw-bold @timeColor">@item.ScheduledTime.ToString("HH:mm")</h5>
                                        <span class="badge bg-dark rounded-1">@item.LineCode</span>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-1 text-dark">@item.RouteName</h6>
                                        <div class="d-flex align-items-center text-muted small">
                                            <span class="me-3"><i class="bi bi-person-fill me-1"></i> @item.DriverName</span>
                                            <span><i class="bi bi-truck me-1"></i> @item.PlateNumber</span>
                                        </div>

                                        @if (item.IsDelayed)
                                        {
                                            <div class="text-danger small fw-bold mt-1">
                                                <i class="bi bi-hourglass-split"></i> @item.DelayMinutes dk gecikme tespit edildi!
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="text-end">
                                    <div class="mb-2">@Html.Raw(statusBadge)</div>
                                    <a asp-controller="TripTasks" asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-light border rounded-circle" title="Detay İncele">
                                        <i class="bi bi-chevron-right text-muted"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <img src="/assets/img/illustrations/empty.svg" style="width: 120px; opacity: 0.5;" class="mb-3 d-none">
                <i class="bi bi-calendar2-check text-muted" style="font-size: 4rem; opacity: 0.3;"></i>
                <h5 class="text-muted mt-3">Planlanmış sefer yok</h5>
                <p class="text-muted small">Bugün için operasyon akışı boş görünüyor.</p>
            </div>
        }
    </div>
</div>