@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // 1. O anki Area, Controller ve Action bilgilerini alıyoruz
    var currentArea = ViewContext.RouteData.Values["Area"]?.ToString();
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();

    // 2. Area + Controller + Action kontrolü yapan fonksiyon
    // Sadece Area "Chief" ise aktif sınıfı döndürür.
    string IsActive(string controller, string action = "Index") =>
        (string.Equals(currentArea, "Chief", StringComparison.OrdinalIgnoreCase) &&
         string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
         string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}

<ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">

    <li class="nav-header text-uppercase text-secondary fw-bold mt-2" style="font-size: 0.75rem; letter-spacing: 1px;">
        ŞEF İŞLEMLERİ
    </li>

    <li class="nav-item">
        <a asp-area="Chief" asp-controller="Home" asp-action="Index"
           class="nav-link @IsActive("Home", "Index")">
            <i class="nav-icon bi bi-speedometer2 text-info"></i>
            <p>Genel Bakış</p>
        </a>
    </li>

    <li class="nav-item">
        <a asp-area="Chief" asp-controller="TripTasks" asp-action="Index"
           class="nav-link @IsActive("TripTasks", "Index")">
            <i class="nav-icon bi bi-clipboard-data text-primary"></i>
            <p>Sefer Görevleri</p>
        </a>
    </li>

</ul>