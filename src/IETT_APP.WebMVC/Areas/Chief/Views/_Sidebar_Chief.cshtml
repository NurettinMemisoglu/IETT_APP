@* Planner rolü için sidebar partial *@
<ul class="nav sidebar-menu flex-column"
    data-lte-toggle="treeview"
    role="navigation"
    aria-label="Main navigation"
    data-accordion="false"
    id="navigation">

    <li class="nav-item menu-open">
        <a href="#" class="nav-link active">
            <i class="nav-icon bi bi-speedometer"></i>
            <p>
                ŞEF
                <i class="nav-arrow bi bi-chevron-right"></i>
            </p>
        </a>
        <ul class="nav nav-treeview" role="navigation" aria-label="Navigation 4">
            <li class="nav-item">
                <a asp-area="Chief" asp-action="Index" asp-controller="TripTasks" class="nav-link">
                    <i class="nav-icon bi bi-circle"></i>
                    <p>Sefer Görevleri</p>
                </a>
            </li>
        </ul>
    </li>
</ul>

<ul class="nav flex-column" style="position: absolute; bottom: 10px; left: 0; width: 100%;">
    @if (!User.Identity.IsAuthenticated)
    {
        <li class="nav-item">
            <a asp-area="Identity" asp-controller="Account" asp-action="Register" class="nav-link">
                <i class="nav-icon bi bi-person-plus"></i>
                <p>Register</p>
            </a>
        </li>

        <li class="nav-item">
            <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="nav-link">
                <i class="nav-icon bi bi-box-arrow-in-right"></i>
                <p>Login</p>
            </a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a asp-area="Identity" asp-controller="Account" asp-action="Logout" class="nav-link">
                <i class="nav-icon bi bi-box-arrow-right"></i>
                <p>Logout</p>
            </a>
        </li>
    }
</ul>