@using IETT_APP.WebMVC.Extensions
@using IETT_APP.Domain.Enums
@model IEnumerable<IETT_APP.WebMVC.Areas.Chief.Models.TripTaskViewModel>

<div class="card shadow-sm border-0 table-container">
    <div class="card-body table-responsive p-0">
        <table class="table table-hover table-striped align-middle mb-0" style="font-size: 0.9rem;">
            <thead class="table-dark sticky-top text-nowrap">
                <tr>
                    <th>Durum</th>
                    <th>Görev / Hat</th>
                    <th>Kaynaklar (Araç & Şoför)</th>
                    <th>Zamanlama (Tarih & Saat)</th>
                    <th class="text-center">Metrikler</th>
                    <th>Kayıt Bilgisi</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="task-row" data-id="@item.Id">

                            <td>
                                @{
                                    var statusClass = item.Status switch
                                    {
                                        TaskState.Pending => "bg-warning text-dark",
                                        TaskState.InProgress => "bg-primary",
                                        TaskState.Completed => "bg-success",
                                        TaskState.Cancelled => "bg-danger",
                                        TaskState.Incomplete => "bg-secondary",
                                        _ => "bg-light text-dark border"
                                    };
                                }

                                <div class="d-flex align-items-center">
                                    <span class="badge @statusClass rounded-pill px-3 py-2">@item.Status.ToDisplayName()</span>

                                    @if (!string.IsNullOrEmpty(item.StatusReason))
                                    {
                                        <span class="ms-2 text-danger"
                                              data-bs-toggle="tooltip"
                                              data-bs-placement="top"
                                              title="@item.StatusReason"
                                              style="cursor: help;">
                                            <i class="bi bi-info-circle fs-6"></i>
                                        </span>
                                    }
                                </div>
                            </td>

                            <td>
                                <div class="fw-bold text-primary" title="@item.Description" style="cursor:help">
                                    @item.Title
                                </div>
                                <div class="fw-bold">@item.LineName</div>
                                <div class="small text-muted">
                                    <i class="bi bi-signpost-2 me-1"></i>@item.RouteName
                                </div>
                            </td>

                            <td>
                                <div>
                                    <i class="bi bi-bus-front text-secondary me-1"></i>
                                    <strong>@(item.VehicleName ?? "Araç Yok")</strong>
                                </div>
                                <div class="mt-1">
                                    <i class="bi bi-person-badge text-secondary me-1"></i>
                                    @(item.DriverName ?? "Şoför Yok")
                                </div>
                                <div class="small text-muted mt-1">
                                    <i class="bi bi-building me-1"></i>@(item.GarageName ?? "-")
                                </div>
                            </td>

                            <td class="text-nowrap">
                                <div class="text-secondary" title="Planlanan">
                                    <i class="bi bi-calendar me-1"></i>
                                    @item.ScheduledDeparture?.ToString("dd.MM HH:mm") - @item.ScheduledArrival?.ToString("dd.MM HH:mm")
                                </div>

                                @if (item.AdjustedDeparture.HasValue || item.AdjustedArrival.HasValue)
                                {
                                    <div class="text-warning mt-1" title="Revize Edilen">
                                        <i class="bi bi-pencil-square me-1"></i>
                                        @(item.AdjustedDeparture?.ToString("dd.MM HH:mm") ?? "--") - @(item.AdjustedArrival?.ToString("dd.MM HH:mm") ?? "--")
                                    </div>
                                }

                                @if (item.ActualDeparture.HasValue || item.ActualArrival.HasValue)
                                {
                                    <div class="text-success mt-1 fw-bold" title="Gerçekleşen">
                                        <i class="bi bi-check-circle me-1"></i>
                                        @(item.ActualDeparture?.ToString("dd.MM HH:mm") ?? "--") - @(item.ActualArrival?.ToString("dd.MM HH:mm") ?? "--")
                                    </div>
                                }
                            </td>

                            <td class="text-center">
                                <div class="d-flex flex-column gap-1">
                                    <span class="badge bg-info text-dark" title="Yolcu Sayısı">
                                        <i class="bi bi-people-fill me-1"></i> @(item.PassengerCount ?? 0)
                                    </span>

                                    @if ((item.DelayInMinutes ?? 0) > 0 || (item.DelayOutMinutes ?? 0) > 0)
                                    {
                                        <span class="badge bg-danger" title="Toplam Gecikme">
                                            <i class="bi bi-hourglass-bottom me-1"></i> +@((item.DelayInMinutes ?? 0) + (item.DelayOutMinutes ?? 0)) dk
                                        </span>
                                    }
                                </div>
                            </td>

                            <td>
                                <div class="small text-muted" title="Oluşturulma">
                                    <i class="bi bi-plus-circle me-1"></i> @item.CreatedAt.ToString("dd.MM.yy HH:mm")
                                </div>
                                @if (item.UpdatedAt.HasValue)
                                {
                                    <div class="small text-muted mt-1" title="Son Güncelleme">
                                        <i class="bi bi-pencil-square me-1"></i> @item.UpdatedAt.Value.ToString("dd.MM.yy HH:mm")
                                    </div>
                                }
                            </td>

                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Detay">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-warning edit-trip-task" data-id="@item.Id" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger delete-trip-task" data-id="@item.Id" title="Sil">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="no-data-row">
                        <td colspan="7" class="text-center py-5">
                            <div class="text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                <h5>Kayıtlı görev bulunamadı.</h5>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model != null && Model.Count() > 10)
    {
        <div class="card-footer bg-white border-top py-3 pagination-container">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small page-info">1-10 arası gösteriliyor (Toplam: @Model.Count())</span>
                <nav aria-label="Sayfalama">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item btn-prev disabled">
                            <a class="page-link" href="javascript:void(0)" aria-label="Previous"><span aria-hidden="true">&laquo; Geri</span></a>
                        </li>
                        <li class="page-item active"><span class="page-link current-page-num">1</span></li>
                        <li class="page-item btn-next">
                            <a class="page-link" href="javascript:void(0)" aria-label="Next"><span aria-hidden="true">İleri &raquo;</span></a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>