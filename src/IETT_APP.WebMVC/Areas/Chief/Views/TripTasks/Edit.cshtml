@using IETT_APP.WebMVC.Areas.Chief.Models
@model TripTaskViewModel

@{
    ViewData["Title"] = "Görev Düzenle";

    //Gelinen sayfayı (Referer) yakala
    var referer = ViewContext.HttpContext.Request.Headers["Referer"].ToString();

    // Eğer referer boşsa (direkt link) varsayılan olarak Index'e dön, doluysa oraya dön
    var backUrl = string.IsNullOrEmpty(referer) ? Url.Action("Index") : referer;
}

<div class="container-fluid mt-4">
    <div class="card card-warning card-outline shadow-sm">
        <div class="card-header">
            <h3 class="card-title fw-bold">
                <i class="bi bi-pencil-square me-2"></i> Görev Düzenle
            </h3>
            <div class="card-tools">
                <span class="badge bg-secondary">ID: @Model.Id.ToString().Substring(0, 8)...</span>
            </div>
        </div>
        <div class="card-body">

            <form id="tripTaskForm">
                @await Html.PartialAsync("_TripTaskFormPartial", Model)

                <div class="row mt-4">
                    <div class="col-12 text-end">
                        <a href="@backUrl" onclick="if(history.length > 1){ history.back(); return false; }" class="btn btn-secondary me-2">
                            <i class="bi bi-x-lg"></i> İptal
                        </a>

                        <button type="button" id="btnSaveTask" class="btn btn-warning px-4 text-dark fw-bold">
                            <i class="bi bi-check-lg"></i> Değişiklikleri Kaydet
                        </button>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        var allLines = @Html.Raw(ViewBag.LinesJson ?? "[]");
        var allRoutes = @Html.Raw(ViewBag.RoutesJson ?? "[]");
        var allGarages = @Html.Raw(ViewBag.GaragesJson ?? "[]");
        var allVehicles = @Html.Raw(ViewBag.VehiclesJson ?? "[]");
        var allDrivers = @Html.Raw(ViewBag.DriversJson ?? "[]");
    </script>

    <script src="~/js/chief-triptask.js"></script>
}